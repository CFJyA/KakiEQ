<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="KakiEQ_WinUI.Views.EqualizerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:KakiEQ_WinUI.Models"
    xmlns:vm="using:KakiEQ_WinUI.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28">
        <StackPanel Spacing="28" MaxWidth="1100" HorizontalAlignment="Stretch">

            <!-- Header with Title, Bypass Toggle, and Reset -->
            <Grid>
                <StackPanel VerticalAlignment="Center" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Ecualizador Gráfico DSP" FontSize="26" FontWeight="Bold" Foreground="White"/>
                        <Border Background="#2B1445" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock Text="10 BANDAS" FontSize="11" FontWeight="Bold" Foreground="#D0BCFF"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Ajuste paramétrico de alta fidelidad con procesamiento BASS DirectX" 
                               FontSize="13" Foreground="#888888"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="16" VerticalAlignment="Center">
                    <!-- Toggle Switch -->
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="EQ Activo" FontSize="13" Foreground="#B0B0B0" VerticalAlignment="Center"/>
                        <ToggleSwitch IsOn="{Binding IsEnabled, Mode=TwoWay}"
                                      OnContent="" OffContent="" Margin="0"/>
                    </StackPanel>

                    <!-- Reset Button -->
                    <Button Command="{Binding ResetCommand}"
                            Background="#1E1E1E" BorderBrush="#333333" Foreground="#D0BCFF"
                            CornerRadius="16" Padding="14,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                            <TextBlock Text="Reiniciar (0 dB)" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Presets Bar (Material Chips) -->
            <Border Background="#181818" BorderBrush="#262626" BorderThickness="1" CornerRadius="16" Padding="16,12">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Perfiles:" FontSize="13" FontWeight="SemiBold" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,6,0"/>

                    <ListView ItemsSource="{Binding Presets}"
                              SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                              SelectionMode="Single"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:EqualizerPreset">
                                <Border Background="#252525" CornerRadius="14" Padding="14,6" Margin="4,0">
                                    <TextBlock Text="{x:Bind Name}" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- 10 Bands Equalizer Rack (Hardware Style Surface) -->
            <Border Background="#161616" BorderBrush="#252525" BorderThickness="1" CornerRadius="20" Padding="28,24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="280"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- dB Markers Reference Line (Top) -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="+15 dB" HorizontalAlignment="Left" FontSize="11" Foreground="#555555"/>
                        <TextBlock Text="0 dB (Plano)" HorizontalAlignment="Center" FontSize="11" Foreground="#444444"/>
                        <TextBlock Text="+15 dB" HorizontalAlignment="Right" FontSize="11" Foreground="#555555"/>
                    </Grid>

                    <!-- Sliders Grid -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Bands}" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:EqualizerBand">
                                <StackPanel Width="88" HorizontalAlignment="Center" VerticalAlignment="Stretch" Spacing="8">
                                    <!-- Current Gain Readout -->
                                    <Border Background="#201A29" CornerRadius="6" Padding="6,2" HorizontalAlignment="Center">
                                        <TextBlock Text="{x:Bind GainFormatted, Mode=OneWay}" 
                                                   FontSize="11" FontWeight="Bold" Foreground="#BB86FC"
                                                   HorizontalAlignment="Center"/>
                                    </Border>

                                    <!-- Vertical Slider -->
                                    <Slider Orientation="Vertical"
                                            Minimum="-15" Maximum="15" StepFrequency="0.5"
                                            Value="{x:Bind Gain, Mode=TwoWay}"
                                            Height="210" Width="36"
                                            HorizontalAlignment="Center"
                                            TickFrequency="5" TickPlacement="Outside"/>

                                    <!-- Frequency Label -->
                                    <TextBlock Text="{x:Bind Label}" FontSize="12" FontWeight="SemiBold" Foreground="#A0A0A0"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- dB Markers Reference Line (Bottom) -->
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <TextBlock Text="-15 dB" HorizontalAlignment="Left" FontSize="11" Foreground="#555555"/>
                        <TextBlock Text="Respuesta de Frecuencia (Sub-grave → Agudo)" HorizontalAlignment="Center" FontSize="11" Foreground="#555555"/>
                        <TextBlock Text="-15 dB" HorizontalAlignment="Right" FontSize="11" Foreground="#555555"/>
                    </Grid>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

