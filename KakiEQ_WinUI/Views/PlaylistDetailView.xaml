<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KakiEQ_WinUI.Views.PlaylistDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:KakiEQ_WinUI.Models"
    xmlns:vm="using:KakiEQ_WinUI.ViewModels"
    xmlns:helpers="using:KakiEQ_WinUI.Helpers"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid Padding="24,18,24,0" helpers:FluidAnimationHelper.IsFluidLayoutEnabled="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT COLUMN: Back button, Enlarged Cover art (330px), Details, Stats, Action buttons -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,116">
            <StackPanel Width="330" HorizontalAlignment="Left" Spacing="14" helpers:FluidAnimationHelper.IsFluidLayoutEnabled="True">
                <!-- Back Button -->
                <Button Command="{x:Bind ViewModel.GoBackCommand, Mode=OneWay}"
                        Background="#22FFFFFF" Foreground="{ThemeResource AppTextPrimary}" Width="40" Height="40"
                        CornerRadius="20" Padding="0" HorizontalAlignment="Left"
                        helpers:FluidAnimationHelper.HoverMode="Icon"
                        ToolTipService.ToolTip="Regresar a Playlists">
                    <FontIcon Glyph="&#xE72B;" FontSize="15"/>
                </Button>

                <!-- Cover Artwork (Enlarged to 330x330, perfectly matching the stats and action buttons below) -->
                <Grid Width="330" Height="330" CornerRadius="22" Background="{ThemeResource AppAccentSurface}"
                      helpers:FluidAnimationHelper.IsFluidLayoutEnabled="True">
                    <FontIcon Glyph="&#xE8F1;" FontSize="72" Foreground="{ThemeResource AppAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image Source="{x:Bind ViewModel.CurrentPlaylist.CoverHeroSource, Mode=OneWay}" Stretch="UniformToFill"/>
                    <Rectangle RadiusX="21" RadiusY="21" Stroke="{ThemeResource AppBorder}" StrokeThickness="1.15" Margin="1" UseLayoutRounding="False" IsHitTestVisible="False"/>
                </Grid>

                <!-- Title & Badge Row -->
                <StackPanel Spacing="4" Margin="0,2,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.CurrentPlaylist.Name, Mode=OneWay}"
                                   FontSize="26" FontWeight="Bold" Foreground="{ThemeResource AppTextPrimary}"
                                   TextTrimming="CharacterEllipsis" MaxLines="2" VerticalAlignment="Center"/>
                        <Border Background="{ThemeResource AppAccentContainer}" CornerRadius="8" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock Text="PLAYLIST" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource AppAccentText}"/>
                        </Border>
                    </StackPanel>

                    <!-- Description -->
                    <TextBlock Text="{x:Bind ViewModel.CurrentPlaylist.Description, Mode=OneWay}"
                               FontSize="13" Foreground="{ThemeResource AppTextSecondary}"
                               TextWrapping="Wrap" MaxLines="3" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Information Subtitle -->
                <TextBlock Text="INFORMACIÓN" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppTextSubtle}" Margin="0,4,0,0"/>

                <!-- Stat Cards (2 columns, 330px total width) -->
                <Grid ColumnSpacing="10" Width="330">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Canciones -->
                    <Grid Grid.Column="0" Background="{ThemeResource AppCardBackground}" CornerRadius="14">
                        <Rectangle RadiusX="13" RadiusY="13" Stroke="{ThemeResource AppBorder}" StrokeThickness="1.15" Margin="1" UseLayoutRounding="False" IsHitTestVisible="False"/>
                        <StackPanel Spacing="2" Padding="14,10">
                            <TextBlock Text="{x:Bind ViewModel.TotalSongs, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource AppAccent}"/>
                            <TextBlock Text="Canciones" FontSize="11" Foreground="{ThemeResource AppTextSubtle}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Duración Total -->
                    <Grid Grid.Column="1" Background="{ThemeResource AppCardBackground}" CornerRadius="14">
                        <Rectangle RadiusX="13" RadiusY="13" Stroke="{ThemeResource AppBorder}" StrokeThickness="1.15" Margin="1" UseLayoutRounding="False" IsHitTestVisible="False"/>
                        <StackPanel Spacing="2" Padding="14,10">
                            <TextBlock Text="{x:Bind ViewModel.TotalLength, Mode=OneWay}" FontSize="17" FontWeight="Bold" Foreground="{ThemeResource AppSecondary}"/>
                            <TextBlock Text="Duración Total" FontSize="11" Foreground="{ThemeResource AppTextSubtle}"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Action Buttons: Reproducir Todo (Full Width), Editar & Eliminar (50% / 50% con diseño sin recortes y colores exactos) -->
                <StackPanel Spacing="10" Margin="0,6,0,16" Width="330">
                    <!-- Reproducir Todo -->
                    <Button Command="{x:Bind ViewModel.PlayAllCommand, Mode=OneWay}"
                            HorizontalAlignment="Stretch" Height="42"
                            Background="{ThemeResource AppAccent}" Foreground="#121212"
                            CornerRadius="21" Padding="16,0"
                            helpers:FluidAnimationHelper.HoverMode="Fab">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="#121212"/>
                            <TextBlock Text="Reproducir Todo" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#121212"/>
                        </StackPanel>
                    </Button>

                    <!-- Editar y Eliminar en fila balanceada de 2 columnas (50% / 50%) -->
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Editar -->
                        <Button Grid.Column="0" Click="EditPlaylist_Click"
                                HorizontalAlignment="Stretch" Height="38"
                                Background="{ThemeResource AppSurfaceElevated}"
                                BorderBrush="{ThemeResource AppBorder}" BorderThickness="1"
                                CornerRadius="19" Padding="10,0" ToolTipService.ToolTip="Editar foto, nombre y descripción"
                                helpers:FluidAnimationHelper.HoverMode="Button">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="7">
                                <FontIcon Glyph="&#xE70F;" FontSize="13" Foreground="{ThemeResource AppAccent}"/>
                                <TextBlock Text="Editar" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimary}"/>
                            </StackPanel>
                        </Button>

                        <!-- Eliminar (Estilo vino/rojo suave idéntico al mockup) -->
                        <Button Grid.Column="1" Click="DeletePlaylist_Click"
                                Visibility="{x:Bind ViewModel.DeleteVisibility, Mode=OneWay}"
                                HorizontalAlignment="Stretch" Height="38"
                                Background="#2A1622" BorderBrush="#502030" BorderThickness="1"
                                CornerRadius="19" Padding="10,0" ToolTipService.ToolTip="Eliminar playlist permanentemente"
                                helpers:FluidAnimationHelper.HoverMode="Button">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="7">
                                <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="#FF8095"/>
                                <TextBlock Text="Eliminar" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#FF8095"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Subtle Vertical Separator -->
        <Border Grid.Column="1" Width="1" Background="{ThemeResource AppBorder}" Margin="0,4,20,116"/>

        <!-- RIGHT COLUMN: Tracklist (Full height, scrollable, drag-and-drop reorderable, aesthetic spacing) -->
        <Grid Grid.Column="2" helpers:FluidAnimationHelper.IsFluidLayoutEnabled="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Toolbar: PISTAS (count) on Left, Uniform Filter/Sort Pills on Right -->
            <Grid Grid.Row="0" Margin="10,0,10,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- PISTAS (count) -->
                <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.TotalSongsText, Mode=OneWay}"
                           FontSize="14" FontWeight="Bold" Foreground="{ThemeResource AppTextPrimary}"
                           VerticalAlignment="Center"/>

                <!-- Sorting Pills (Personalizado, BPM, Armónico) con borde 100% uniforme sin engrosamiento en curvas -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- 1. Orden Personalizado / Original -->
                    <Button Command="{x:Bind ViewModel.SortCustomCommand, Mode=OneWay}"
                            Background="Transparent" BorderThickness="0" Padding="0" Height="32" CornerRadius="16"
                            helpers:FluidAnimationHelper.HoverMode="Button"
                            ToolTipService.ToolTip="Restablecer al orden original / personalizado de la playlist">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                        </Button.Resources>
                        <Grid Height="32">
                            <Rectangle RadiusX="15" RadiusY="15"
                                       Fill="{x:Bind ViewModel.CustomSortBgBrush, Mode=OneWay}"
                                       Stroke="{x:Bind ViewModel.CustomSortBorderBrush, Mode=OneWay}"
                                       StrokeThickness="1" Margin="1"
                                       UseLayoutRounding="False" IsHitTestVisible="False"/>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="14,0">
                                <FontIcon Glyph="&#xE8D2;" FontSize="11" Foreground="{x:Bind ViewModel.CustomSortFgBrush, Mode=OneWay}"/>
                                <TextBlock Text="Personalizado" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{x:Bind ViewModel.CustomSortFgBrush, Mode=OneWay}"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- 2. Ordenar por BPM -->
                    <Button Command="{x:Bind ViewModel.SortByBpmCommand, Mode=OneWay}"
                            Background="Transparent" BorderThickness="0" Padding="0" Height="32" CornerRadius="16"
                            helpers:FluidAnimationHelper.HoverMode="Button"
                            ToolTipService.ToolTip="Ordenar por velocidad / tempo (Alternar Ascendente / Descendente)">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                        </Button.Resources>
                        <Grid Height="32">
                            <Rectangle RadiusX="15" RadiusY="15"
                                       Fill="{x:Bind ViewModel.BpmSortBgBrush, Mode=OneWay}"
                                       Stroke="{x:Bind ViewModel.BpmSortBorderBrush, Mode=OneWay}"
                                       StrokeThickness="1" Margin="1"
                                       UseLayoutRounding="False" IsHitTestVisible="False"/>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="14,0">
                                <FontIcon Glyph="&#xE8CB;" FontSize="11" Foreground="{x:Bind ViewModel.BpmSortFgBrush, Mode=OneWay}"/>
                                <TextBlock Text="{x:Bind ViewModel.SortByBpmLabel, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{x:Bind ViewModel.BpmSortFgBrush, Mode=OneWay}"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- 3. Orden Armónico -->
                    <Button Command="{x:Bind ViewModel.SortHarmonicallyCommand, Mode=OneWay}"
                            Background="Transparent" BorderThickness="0" Padding="0" Height="32" CornerRadius="16"
                            helpers:FluidAnimationHelper.HoverMode="Button"
                            ToolTipService.ToolTip="Ordenar consecutivamente por compatibilidad armónica de DJing (Rueda Camelot)">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                        </Button.Resources>
                        <Grid Height="32">
                            <Rectangle RadiusX="15" RadiusY="15"
                                       Fill="{x:Bind ViewModel.HarmonicSortBgBrush, Mode=OneWay}"
                                       Stroke="{x:Bind ViewModel.HarmonicSortBorderBrush, Mode=OneWay}"
                                       StrokeThickness="1" Margin="1"
                                       UseLayoutRounding="False" IsHitTestVisible="False"/>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="14,0">
                                <FontIcon Glyph="&#xEC4F;" FontSize="11" Foreground="{x:Bind ViewModel.HarmonicSortFgBrush, Mode=OneWay}"/>
                                <TextBlock Text="Armónico" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{x:Bind ViewModel.HarmonicSortFgBrush, Mode=OneWay}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Header Row with column hints (Sin línea divisoria para mantener uniformidad con AlbumDetail y ArtistDetail) -->
            <Grid Grid.Row="1" Margin="10,6,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="124"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="#" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppTextSubtle}" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="TÍTULO" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppTextSubtle}"/>
                <TextBlock Grid.Column="2" Text="ÁLBUM" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppTextSubtle}"/>
                <TextBlock Grid.Column="3" Text="CLAVE · BPM" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppTextSubtle}" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="4" Text="DURACIÓN" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppTextSubtle}" HorizontalAlignment="Right"/>
            </Grid>

            <!-- Bounded ListView that scrolls completely and supports drag reordering -->
            <ListView Grid.Row="2"
                      x:Name="TracksListView"
                      ItemsSource="{x:Bind ViewModel.Tracks, Mode=OneWay}"
                      CanReorderItems="True"
                      AllowDrop="True"
                      CanDragItems="True"
                      DragItemsCompleted="TracksListView_DragItemsCompleted"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="Track_ItemClick"
                      Padding="0,0,4,116"
                      helpers:FluidAnimationHelper.EnableGridViewReflow="True">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Track">
                        <Grid Padding="10,8" CornerRadius="8" Background="Transparent"
                              RightTapped="TrackRow_RightTapped" Tag="{x:Bind}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>  <!-- Track index -->
                                <ColumnDefinition Width="*"/>   <!-- Title + Artist -->
                                <ColumnDefinition Width="180"/> <!-- Album name -->
                                <ColumnDefinition Width="124"/> <!-- Camelot Key Pill + BPM -->
                                <ColumnDefinition Width="60"/>  <!-- Duration -->
                                <ColumnDefinition Width="36"/>  <!-- Options menu (3 dots) -->
                            </Grid.ColumnDefinitions>

                            <!-- Track index (1, 2, 3...) -->
                            <TextBlock Grid.Column="0" Text="{x:Bind DisplayIndexFormatted, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource AppTextMuted}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>

                            <!-- Song Title and Artist (stacked vertically, aesthetic alignment) -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{ThemeResource AppTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind Artist}" FontSize="12" Foreground="{ThemeResource AppTextSecondary}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Album Name -->
                            <TextBlock Grid.Column="2" Text="{x:Bind Album}" FontSize="12" Foreground="{ThemeResource AppTextMuted}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>

                            <!-- Camelot Pill Badge + Discrete BPM: [ 8A ] 118 BPM -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0">
                                <Border Background="{x:Bind CamelotBackgroundBrush, Mode=OneWay}"
                                        Visibility="{x:Bind HasCamelotVisibility, Mode=OneWay}"
                                        CornerRadius="8" Padding="7,2" MinWidth="30" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind CamelotKeyFormatted, Mode=OneWay}"
                                               Foreground="{x:Bind CamelotForegroundBrush, Mode=OneWay}"
                                               FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{x:Bind BpmFormatted, Mode=OneWay}"
                                           Visibility="{x:Bind HasBpmVisibility, Mode=OneWay}"
                                           FontSize="11" Foreground="{ThemeResource AppTextMuted}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Duration -->
                            <TextBlock Grid.Column="4" Text="{x:Bind DurationFormatted}" FontSize="12" Foreground="{ThemeResource AppTextMuted}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>

                            <!-- Options Menu (3 dots) -->
                            <Button Grid.Column="5" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource AppTextSubtle}"
                                    Click="MoreButton_Click" Tag="{x:Bind}" Padding="0" Width="30" Height="30" CornerRadius="15"
                                    HorizontalAlignment="Right" ToolTipService.ToolTip="Más opciones"
                                    helpers:FluidAnimationHelper.HoverMode="Icon">
                                <FontIcon Glyph="&#xE712;" FontSize="13"/>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
