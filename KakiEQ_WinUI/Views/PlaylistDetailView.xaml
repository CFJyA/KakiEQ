<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="KakiEQ_WinUI.Views.PlaylistDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:KakiEQ_WinUI.Models"
    xmlns:vm="using:KakiEQ_WinUI.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24,18,24,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT COLUMN: Back button, Enlarged Cover art (330px), Details, Stats, Action buttons -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
            <StackPanel Width="330" HorizontalAlignment="Left" Spacing="14">
                <!-- Back Button -->
                <Button Command="{x:Bind ViewModel.GoBackCommand, Mode=OneWay}"
                        Background="#22FFFFFF" Foreground="{ThemeResource AppTextPrimary}" Width="40" Height="40"
                        CornerRadius="20" Padding="0" HorizontalAlignment="Left"
                        ToolTipService.ToolTip="Regresar a Playlists">
                    <FontIcon Glyph="&#xE72B;" FontSize="15"/>
                </Button>

                <!-- Cover Artwork (Enlarged to 330x330, perfectly matching the stats and action buttons below) -->
                <Border Width="330" Height="330" CornerRadius="22" Background="{ThemeResource AppAccentSurface}">
                    <Grid>
                        <FontIcon Glyph="&#xE8F1;" FontSize="72" Foreground="{ThemeResource AppAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image Source="{x:Bind ViewModel.CurrentPlaylist.CoverImagePath, Mode=OneWay, Converter={StaticResource ImagePathToImageSourceConverter}}" Stretch="UniformToFill"/>
                    </Grid>
                </Border>

                <!-- Title & Badge Row -->
                <StackPanel Spacing="4" Margin="0,2,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.CurrentPlaylist.Name, Mode=OneWay}"
                                   FontSize="26" FontWeight="Bold" Foreground="{ThemeResource AppTextPrimary}"
                                   TextTrimming="CharacterEllipsis" MaxLines="2" VerticalAlignment="Center"/>
                        <Border Background="{ThemeResource AppAccentContainer}" CornerRadius="8" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock Text="PLAYLIST" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource AppAccentText}"/>
                        </Border>
                    </StackPanel>

                    <!-- Description -->
                    <TextBlock Text="{x:Bind ViewModel.CurrentPlaylist.Description, Mode=OneWay}"
                               FontSize="13" Foreground="{ThemeResource AppTextSecondary}"
                               TextWrapping="Wrap" MaxLines="3" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Information Subtitle -->
                <TextBlock Text="INFORMACIÓN" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppTextSubtle}" Margin="0,4,0,0"/>

                <!-- Stat Cards (2 columns, 330px total width) -->
                <Grid ColumnSpacing="10" Width="330">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Canciones -->
                    <Border Grid.Column="0" Background="{ThemeResource AppCardBackground}" BorderBrush="{ThemeResource AppBorder}" BorderThickness="1" CornerRadius="14" Padding="14,10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.TotalSongs, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource AppAccent}"/>
                            <TextBlock Text="Canciones" FontSize="11" Foreground="{ThemeResource AppTextSubtle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Duración Total -->
                    <Border Grid.Column="1" Background="{ThemeResource AppCardBackground}" BorderBrush="{ThemeResource AppBorder}" BorderThickness="1" CornerRadius="14" Padding="14,10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.TotalLength, Mode=OneWay}" FontSize="17" FontWeight="Bold" Foreground="{ThemeResource AppSecondary}"/>
                            <TextBlock Text="Duración Total" FontSize="11" Foreground="{ThemeResource AppTextSubtle}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Action Buttons: Reproducir Todo (Full Width), Editar & Eliminar (50% / 50% con diseño sin recortes y colores exactos) -->
                <StackPanel Spacing="10" Margin="0,6,0,16" Width="330">
                    <!-- Reproducir Todo -->
                    <Button Command="{x:Bind ViewModel.PlayAllCommand, Mode=OneWay}"
                            HorizontalAlignment="Stretch" Height="42"
                            Background="{ThemeResource AppAccent}" Foreground="#121212"
                            CornerRadius="21" Padding="16,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="#121212"/>
                            <TextBlock Text="Reproducir Todo" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#121212"/>
                        </StackPanel>
                    </Button>

                    <!-- Editar y Eliminar en fila balanceada de 2 columnas (50% / 50%) -->
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Editar -->
                        <Button Grid.Column="0" Click="EditPlaylist_Click"
                                HorizontalAlignment="Stretch" Height="38"
                                Background="{ThemeResource AppSurfaceElevated}"
                                BorderBrush="{ThemeResource AppBorder}" BorderThickness="1"
                                CornerRadius="19" Padding="10,0" ToolTipService.ToolTip="Editar foto, nombre y descripción">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="7">
                                <FontIcon Glyph="&#xE70F;" FontSize="13" Foreground="{ThemeResource AppAccent}"/>
                                <TextBlock Text="Editar" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimary}"/>
                            </StackPanel>
                        </Button>

                        <!-- Eliminar (Estilo vino/rojo suave idéntico al mockup) -->
                        <Button Grid.Column="1" Click="DeletePlaylist_Click"
                                Visibility="{x:Bind ViewModel.DeleteVisibility, Mode=OneWay}"
                                HorizontalAlignment="Stretch" Height="38"
                                Background="#2A1622" BorderBrush="#502030" BorderThickness="1"
                                CornerRadius="19" Padding="10,0" ToolTipService.ToolTip="Eliminar playlist permanentemente">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="7">
                                <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="#FF8095"/>
                                <TextBlock Text="Eliminar" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#FF8095"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Subtle Vertical Separator -->
        <Border Grid.Column="1" Width="1" Background="{ThemeResource AppBorder}" Margin="0,4,20,12"/>

        <!-- RIGHT COLUMN: Tracklist (Full height, scrollable, drag-and-drop reorderable, aesthetic spacing) -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Row with column hints -->
            <Grid Grid.Row="0" Margin="10,8,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="#" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppTextSubtle}" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TotalSongsText, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppTextSubtle}"/>
                <TextBlock Grid.Column="2" Text="ÁLBUM" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppTextSubtle}"/>
                <TextBlock Grid.Column="3" Text="DURACIÓN" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppTextSubtle}" HorizontalAlignment="Right"/>
            </Grid>

            <!-- Bounded ListView that scrolls completely and supports drag reordering -->
            <ListView Grid.Row="1"
                      x:Name="TracksListView"
                      ItemsSource="{x:Bind ViewModel.Tracks, Mode=OneWay}"
                      CanReorderItems="True"
                      AllowDrop="True"
                      CanDragItems="True"
                      DragItemsCompleted="TracksListView_DragItemsCompleted"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="Track_ItemClick"
                      Padding="0,0,4,16">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Track">
                        <Grid Padding="10,8" CornerRadius="8" Background="Transparent"
                              RightTapped="TrackRow_RightTapped" Tag="{x:Bind}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>  <!-- Track index -->
                                <ColumnDefinition Width="*"/>   <!-- Title + Artist -->
                                <ColumnDefinition Width="220"/> <!-- Album name -->
                                <ColumnDefinition Width="60"/>  <!-- Duration -->
                                <ColumnDefinition Width="36"/>  <!-- Options menu (3 dots) -->
                            </Grid.ColumnDefinitions>

                            <!-- Track index (1, 2, 3...) -->
                            <TextBlock Grid.Column="0" Text="{x:Bind DisplayIndexFormatted, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource AppTextMuted}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>

                            <!-- Song Title and Artist (stacked vertically, aesthetic alignment) -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{ThemeResource AppTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind Artist}" FontSize="12" Foreground="{ThemeResource AppTextSecondary}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Album Name -->
                            <TextBlock Grid.Column="2" Text="{x:Bind Album}" FontSize="12" Foreground="{ThemeResource AppTextMuted}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>

                            <!-- Duration -->
                            <TextBlock Grid.Column="3" Text="{x:Bind DurationFormatted}" FontSize="12" Foreground="{ThemeResource AppTextMuted}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>

                            <!-- Options Menu (3 dots) -->
                            <Button Grid.Column="4" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource AppTextSubtle}"
                                    Click="MoreButton_Click" Tag="{x:Bind}" Padding="0" Width="30" Height="30" CornerRadius="15"
                                    HorizontalAlignment="Right" ToolTipService.ToolTip="Más opciones">
                                <FontIcon Glyph="&#xE712;" FontSize="13"/>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
