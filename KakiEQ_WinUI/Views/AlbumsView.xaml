<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="KakiEQ_WinUI.Views.AlbumsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:KakiEQ_WinUI.Models"
    xmlns:vm="using:KakiEQ_WinUI.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Álbumes" FontSize="26" FontWeight="Bold" Foreground="{ThemeResource AppTextPrimary}"/>
                <TextBlock Text="Explora tu colección de música organizada por álbumes" FontSize="13" Foreground="{ThemeResource AppTextSubtle}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                <!-- Search Bar -->
                <TextBox Width="260"
                         Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Buscar álbumes o artistas..."
                         Background="{ThemeResource AppSurfaceContainer}" BorderBrush="{ThemeResource AppBorder}" CornerRadius="12" Padding="12,6"/>

                <!-- Albums Count Pill -->
                <Border Background="{ThemeResource AppSurfaceElevated}" CornerRadius="12" Padding="10,6">
                    <TextBlock Text="{x:Bind ViewModel.TotalAlbumsCountFormatted, Mode=OneWay}"
                               FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppAccent}"/>
                </Border>
            </StackPanel>
        </Grid>

        <GridView x:Name="AlbumsGridView"
                  Grid.Row="1" ItemsSource="{x:Bind ViewModel.Albums, Mode=OneWay}"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="Album_ItemClick"
                  SizeChanged="AlbumsGridView_SizeChanged"
                  Loaded="AlbumsGridView_Loaded">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:AlbumItem">
                    <Border HorizontalAlignment="Stretch" Height="230" Margin="6" CornerRadius="16"
                            Background="{ThemeResource AppCardBackground}" BorderBrush="{ThemeResource AppBorder}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="160"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Cover Artwork -->
                            <Border Grid.Row="0" CornerRadius="16,16,0,0" Background="{ThemeResource AppCoverPlaceholderBg}">
                                <Grid>
                                    <FontIcon Glyph="&#xE93C;" FontSize="44" Foreground="{ThemeResource AppCoverPlaceholderFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image Source="{x:Bind CoverImagePath}" Stretch="UniformToFill"/>
                                </Grid>
                            </Border>

                            <!-- Bottom Tag -->
                            <Border Grid.Row="1" Background="{ThemeResource AppSurfaceElevated}" BorderBrush="{ThemeResource AppBorder}" BorderThickness="0,1,0,0" CornerRadius="0,0,16,16" Padding="12,8">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource AppTextPrimary}"
                                               TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                    <TextBlock Text="{x:Bind Artist}" FontSize="11" Foreground="{ThemeResource AppTextSecondary}"
                                               TextTrimming="CharacterEllipsis" MaxLines="1" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</UserControl>

