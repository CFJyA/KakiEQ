<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="KakiEQ_WinUI.Views.AlbumsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:KakiEQ_WinUI.Models"
    xmlns:vm="using:KakiEQ_WinUI.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Álbumes" FontSize="26" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Explora tu colección de música organizada por álbumes" FontSize="13" Foreground="#888888" Margin="0,4,0,0"/>
        </StackPanel>

        <GridView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Albums, Mode=OneWay}"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="Album_ItemClick">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:AlbumItem">
                    <Border Width="170" Height="230" Margin="6" CornerRadius="16"
                            Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="160"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Cover Artwork -->
                            <Border Grid.Row="0" CornerRadius="16,16,0,0" Background="#242424">
                                <Grid>
                                    <FontIcon Glyph="&#xE93C;" FontSize="44" Foreground="#444444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image Source="{x:Bind CoverImagePath}" Stretch="UniformToFill"/>
                                </Grid>
                            </Border>

                            <!-- Bottom Tag -->
                            <Border Grid.Row="1" Background="#1E1A26" BorderBrush="#2B2236" BorderThickness="0,1,0,0" CornerRadius="0,0,16,16" Padding="12,8">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="Bold" FontSize="13" Foreground="White"
                                               TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                    <TextBlock Text="{x:Bind Artist}" FontSize="11" Foreground="#D0D0D0"
                                               TextTrimming="CharacterEllipsis" MaxLines="1" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</UserControl>

