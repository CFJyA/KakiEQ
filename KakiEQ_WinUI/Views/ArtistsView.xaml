<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KakiEQ_WinUI.Views.ArtistsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:KakiEQ_WinUI.Models"
    xmlns:vm="using:KakiEQ_WinUI.ViewModels"
    xmlns:helpers="using:KakiEQ_WinUI.Helpers"
    NavigationCacheMode="Required"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Template Unificado con Borde Vectorial Uniforme y Animación Hover -->
        <DataTemplate x:Key="ArtistCardTemplate" x:DataType="models:ArtistItem">
            <Border Margin="5" CornerRadius="16"
                    Background="{ThemeResource AppCardBackground}" BorderThickness="0"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    helpers:FluidAnimationHelper.HoverMode="Card"
                    helpers:FluidAnimationHelper.IsFluidLayoutEnabled="True">
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="12">
                        <!-- Circular Avatar -->
                        <Border Width="96" Height="96" CornerRadius="48" Background="{ThemeResource AppCoverPlaceholderBg}" HorizontalAlignment="Center">
                            <Grid>
                                <FontIcon Glyph="&#xE77B;" FontSize="38" Foreground="{ThemeResource AppCoverPlaceholderFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{x:Bind CoverCardSource, Mode=OneWay}" Stretch="UniformToFill"/>
                            </Grid>
                        </Border>

                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource AppTextPrimary}"
                                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                            <TextBlock Text="{x:Bind TrackCountFormatted, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AppTextSubtle}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Uniform Vector Border -->
                    <Rectangle RadiusX="15" RadiusY="15"
                               Stroke="{ThemeResource AppBorder}" StrokeThickness="1.2"
                               Margin="1" UseLayoutRounding="False" IsHitTestVisible="False"
                               Tag="UniformBorderRect"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="14,18,16,0" helpers:FluidAnimationHelper.IsFluidLayoutEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20" helpers:FluidAnimationHelper.IsFluidLayoutEnabled="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" helpers:FluidAnimationHelper.IsFluidLayoutEnabled="True">
                <TextBlock Text="Artistas" FontSize="26" FontWeight="Bold" Foreground="{ThemeResource AppTextPrimary}"/>
                <TextBlock Text="Todos los intérpretes y creadores en tu biblioteca" FontSize="13" Foreground="{ThemeResource AppTextSubtle}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12"
                        helpers:FluidAnimationHelper.IsFluidLayoutEnabled="True">
                <!-- Search Bar -->
                <TextBox Width="260"
                         Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Buscar artistas..."
                         Background="{ThemeResource AppSurfaceContainer}" BorderBrush="{ThemeResource AppBorder}" CornerRadius="12" Padding="12,6"/>

                <!-- Artists Count Pill -->
                <Border Background="{ThemeResource AppSurfaceElevated}" CornerRadius="12" Padding="10,6">
                    <TextBlock Text="{x:Bind ViewModel.TotalArtistsCountFormatted, Mode=OneWay}"
                               FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppAccent}"/>
                </Border>
            </StackPanel>
        </Grid>

        <GridView x:Name="ArtistsGridView"
                  Grid.Row="1" ItemsSource="{x:Bind ViewModel.Artists, Mode=OneWay}"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="Artist_ItemClick"
                  HorizontalAlignment="Stretch"
                  Padding="0,0,0,116"
                  ItemTemplate="{StaticResource ArtistCardTemplate}"
                  helpers:FluidAnimationHelper.EnableGridViewReflow="True">
            <GridView.ItemContainerTransitions>
                <TransitionCollection>
                    <RepositionThemeTransition IsStaggeringEnabled="False"/>
                </TransitionCollection>
            </GridView.ItemContainerTransitions>
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="GridViewItem">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Margin="{TemplateBinding Padding}"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" HorizontalAlignment="Left" ItemWidth="174" ItemHeight="218"/>
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
        </GridView>
    </Grid>
</Page>
