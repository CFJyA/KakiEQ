<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="KakiEQ_WinUI.Views.ArtistsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:KakiEQ_WinUI.Models"
    xmlns:vm="using:KakiEQ_WinUI.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Artistas" FontSize="26" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Todos los intérpretes y creadores en tu biblioteca" FontSize="13" Foreground="#888888" Margin="0,4,0,0"/>
        </StackPanel>

        <GridView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Artists, Mode=OneWay}"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="Artist_ItemClick">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:ArtistItem">
                    <Border Width="170" Height="210" Margin="6" CornerRadius="16"
                            Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1"
                            Padding="16">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                            <!-- Circular Avatar -->
                            <Border Width="100" Height="100" CornerRadius="50" Background="#262626" HorizontalAlignment="Center">
                                <Grid>
                                    <FontIcon Glyph="&#xE77B;" FontSize="40" Foreground="#555555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image Source="{x:Bind CoverImagePath}" Stretch="UniformToFill"/>
                                </Grid>
                            </Border>

                            <StackPanel HorizontalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="14" Foreground="White"
                                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                <TextBlock Text="{x:Bind TrackCountFormatted}" FontSize="11" Foreground="#888888"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</UserControl>

