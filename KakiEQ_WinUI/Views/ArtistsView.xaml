<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="KakiEQ_WinUI.Views.ArtistsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:KakiEQ_WinUI.Models"
    xmlns:vm="using:KakiEQ_WinUI.ViewModels"
    mc:Ignorable="d"
    Loaded="UserControl_Loaded"
    SizeChanged="UserControl_SizeChanged">

    <UserControl.Resources>
        <!-- Template Unificado de Alta Fluidez (Adapta tamaño sin reconstruir la UI) -->
        <DataTemplate x:Key="ArtistCardTemplate" x:DataType="models:ArtistItem">
            <Border Margin="4" CornerRadius="16"
                    Background="{ThemeResource AppCardBackground}" BorderBrush="{ThemeResource AppBorder}" BorderThickness="1"
                    Padding="12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <!-- Circular Avatar -->
                    <Border Width="96" Height="96" CornerRadius="48" Background="{ThemeResource AppCoverPlaceholderBg}" HorizontalAlignment="Center">
                        <Grid>
                            <FontIcon Glyph="&#xE77B;" FontSize="38" Foreground="{ThemeResource AppCoverPlaceholderFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Source="{x:Bind CoverImagePath, Mode=OneWay}" Stretch="UniformToFill"/>
                        </Grid>
                    </Border>

                    <StackPanel HorizontalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource AppTextPrimary}"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                        <TextBlock Text="{x:Bind TrackCountFormatted, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AppTextSubtle}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Padding="20,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Artistas" FontSize="26" FontWeight="Bold" Foreground="{ThemeResource AppTextPrimary}"/>
                <TextBlock Text="Todos los intérpretes y creadores en tu biblioteca" FontSize="13" Foreground="{ThemeResource AppTextSubtle}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                <!-- Search Bar -->
                <TextBox Width="260"
                         Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Buscar artistas..."
                         Background="{ThemeResource AppSurfaceContainer}" BorderBrush="{ThemeResource AppBorder}" CornerRadius="12" Padding="12,6"/>

                <!-- Artists Count Pill -->
                <Border Background="{ThemeResource AppSurfaceElevated}" CornerRadius="12" Padding="10,6">
                    <TextBlock Text="{x:Bind ViewModel.TotalArtistsCountFormatted, Mode=OneWay}"
                               FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppAccent}"/>
                </Border>
            </StackPanel>
        </Grid>

        <GridView x:Name="ArtistsGridView"
                  Grid.Row="1" ItemsSource="{x:Bind ViewModel.Artists, Mode=OneWay}"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="Artist_ItemClick"
                  HorizontalAlignment="Stretch"
                  ItemTemplate="{StaticResource ArtistCardTemplate}">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" HorizontalAlignment="Left" ItemWidth="171" ItemHeight="216"/>
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
        </GridView>
    </Grid>
</UserControl>

