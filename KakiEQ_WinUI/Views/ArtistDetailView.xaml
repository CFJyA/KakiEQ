<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="KakiEQ_WinUI.Views.ArtistDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:KakiEQ_WinUI.Models"
    xmlns:vm="using:KakiEQ_WinUI.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24,18,24,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT COLUMN: Artist Sidebar (Matching Image 1: Circular Avatar, Name, Stats & Discography Play Button) -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
            <StackPanel Width="330" HorizontalAlignment="Left" Spacing="14">
                <!-- Back Button -->
                <Button Command="{Binding GoBackCommand}"
                        Background="#22FFFFFF" Foreground="{ThemeResource AppTextPrimary}" Width="40" Height="40"
                        CornerRadius="20" Padding="0" HorizontalAlignment="Left"
                        ToolTipService.ToolTip="Regresar a Artistas">
                    <FontIcon Glyph="&#xE72B;" FontSize="15"/>
                </Button>

                <!-- Large Circular Artist Avatar (Centered, 280x280) -->
                <Border Width="280" Height="280" CornerRadius="140" Background="{ThemeResource AppCoverPlaceholderBg}" HorizontalAlignment="Center">
                    <Grid>
                        <FontIcon Glyph="&#xE77B;" FontSize="72" Foreground="{ThemeResource AppCoverPlaceholderFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image Source="{Binding BannerImagePath}" Stretch="UniformToFill"/>
                    </Grid>
                </Border>

                <!-- Artist Name & Pill Badge -->
                <StackPanel Spacing="4" Margin="0,2,0,0">
                    <Border Background="{ThemeResource AppAccentContainer}" CornerRadius="8" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,4">
                        <TextBlock Text="ARTISTA" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource AppAccentText}"/>
                    </Border>
                    <TextBlock Text="{Binding ArtistName}" FontSize="28" FontWeight="Bold" Foreground="{ThemeResource AppTextPrimary}"
                               TextTrimming="CharacterEllipsis" MaxLines="2"/>
                </StackPanel>

                <!-- Information Subtitle -->
                <TextBlock Text="INFORMACIÓN" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppTextSubtle}" Margin="0,4,0,0"/>

                <!-- Stat Cards (Matching Image 1: Álbumes & Canciones row 1, Duración Total row 2) -->
                <StackPanel Spacing="10" Width="330">
                    <!-- Row 1: Álbumes y Canciones -->
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Álbumes -->
                        <Border Grid.Column="0" Background="{ThemeResource AppCardBackground}" BorderBrush="{ThemeResource AppBorder}" BorderThickness="1" CornerRadius="14" Padding="14,10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding TotalAlbums}" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource AppAccent}"/>
                                <TextBlock Text="Álbumes" FontSize="11" Foreground="{ThemeResource AppTextSubtle}"/>
                            </StackPanel>
                        </Border>

                        <!-- Canciones -->
                        <Border Grid.Column="1" Background="{ThemeResource AppCardBackground}" BorderBrush="{ThemeResource AppBorder}" BorderThickness="1" CornerRadius="14" Padding="14,10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding TotalSongs}" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource AppSecondary}"/>
                                <TextBlock Text="Canciones" FontSize="11" Foreground="{ThemeResource AppTextSubtle}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Row 2: Duración Total -->
                    <Border Background="{ThemeResource AppCardBackground}" BorderBrush="{ThemeResource AppBorder}" BorderThickness="1" CornerRadius="14" Padding="14,10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding TotalLength}" FontSize="20" FontWeight="Bold" Foreground="#FFB74D"/>
                            <TextBlock Text="Duración Total" FontSize="11" Foreground="{ThemeResource AppTextSubtle}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Action Button: Reproducir Discografía (Full width 330px) -->
                <Button Command="{Binding PlayAllArtistCommand}"
                        HorizontalAlignment="Stretch" Height="42"
                        Background="{ThemeResource AppAccent}" Foreground="#121212"
                        CornerRadius="21" Padding="16,0" Margin="0,4,0,16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="#121212"/>
                        <TextBlock Text="Reproducir Discografía" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#121212"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <!-- Subtle Vertical Separator -->
        <Border Grid.Column="1" Width="1" Background="{ThemeResource AppBorder}" Margin="0,4,20,12"/>

        <!-- RIGHT COLUMN: 50% / 50% Vertical Split (Álbumes en tiles arriba + Lista de canciones abajo) -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>   <!-- Top 50%: Álbumes en TILES -->
                <RowDefinition Height="Auto"/> <!-- Sutil separador horizontal -->
                <RowDefinition Height="*"/>   <!-- Bottom 50%: Pistas del Álbum Seleccionado -->
            </Grid.RowDefinitions>

            <!-- 1. TOP HALF (50%): Álbumes en TILES -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Section Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                    <TextBlock Text="{Binding TotalAlbumsText}" FontSize="13" FontWeight="Bold" Foreground="{ThemeResource AppTextPrimary}"/>
                    <TextBlock Text="(Haz clic en un álbum para ver sus canciones)" FontSize="11" Foreground="{ThemeResource AppTextSubtle}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- GridView con TILES de los álbumes -->
                <GridView Grid.Row="1"
                          ItemsSource="{Binding Albums}"
                          SelectedItem="{Binding SelectedAlbum, Mode=TwoWay}"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemClick="Album_ItemClick"
                          Padding="0,0,0,6">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:AlbumItem">
                            <Grid Width="145" Height="200" Margin="0,0,12,12">
                                <Border Background="{ThemeResource AppCardBackground}" BorderBrush="{ThemeResource AppBorder}" BorderThickness="1" CornerRadius="14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="145"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Cover Tile -->
                                        <Border Grid.Row="0" CornerRadius="14,14,0,0" Background="{ThemeResource AppCoverPlaceholderBg}">
                                            <Grid>
                                                <FontIcon Glyph="&#xE93C;" FontSize="32" Foreground="{ThemeResource AppCoverPlaceholderFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{x:Bind CoverImagePath}" Stretch="UniformToFill"/>
                                            </Grid>
                                        </Border>

                                        <!-- Title & Artist -->
                                        <StackPanel Grid.Row="1" Padding="8,6" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Title}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimary}"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                            <TextBlock Text="{x:Bind Artist}" FontSize="10" Foreground="{ThemeResource AppTextSubtle}"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>

            <!-- 2. Subtle Horizontal Separator between 50% Top and 50% Bottom -->
            <Border Grid.Row="1" Height="1" Background="{ThemeResource AppBorder}" Margin="0,4,0,10"/>

            <!-- 3. BOTTOM HALF (50%): Pistas del Álbum Seleccionado -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Selected Album Header with Play Album Button -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <!-- Small Cover Thumbnail -->
                        <Border Width="42" Height="42" CornerRadius="10" Background="{ThemeResource AppCoverPlaceholderBg}">
                            <Grid>
                                <FontIcon Glyph="&#xE93C;" FontSize="20" Foreground="{ThemeResource AppCoverPlaceholderFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{Binding SelectedAlbum.CoverImagePath}" Stretch="UniformToFill"/>
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{Binding SelectedAlbum.Title, FallbackValue='Selecciona un álbum'}"
                                       FontSize="16" FontWeight="Bold" Foreground="{ThemeResource AppTextPrimary}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                            <TextBlock Text="Pistas del álbum" FontSize="11" Foreground="{ThemeResource AppTextSubtle}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Botón Reproducir Álbum -->
                    <Button Grid.Column="1" Command="{Binding PlayAlbumCommand}"
                            Background="{ThemeResource AppAccent}" Foreground="#121212"
                            CornerRadius="18" Padding="16,8" FontWeight="SemiBold" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE768;" FontSize="13" Foreground="#121212"/>
                            <TextBlock Text="Reproducir Álbum" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#121212"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Scrollable Tracklist of selected album -->
                <Border Grid.Row="1" Background="{ThemeResource AppCardBackground}" BorderBrush="{ThemeResource AppBorder}" BorderThickness="1" CornerRadius="14" Padding="4,4">
                    <ListView ItemsSource="{Binding SelectedAlbumTracks}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="Track_ItemClick"
                              Padding="0,0,4,8">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Track">
                                <Grid Padding="10,7" CornerRadius="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Track Number -->
                                    <TextBlock Grid.Column="0" Text="{x:Bind TrackNumber}" FontSize="12" Foreground="{ThemeResource AppTextMuted}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                    <!-- Title -->
                                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AppTextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                    <!-- Duration -->
                                    <TextBlock Grid.Column="2" Text="{x:Bind DurationFormatted}" FontSize="11" Foreground="{ThemeResource AppTextMuted}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                    <!-- Add to playlist button -->
                                    <Button Grid.Column="3" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource AppTextSubtle}"
                                            Click="AddSingleTrackToPlaylist_Click" Tag="{x:Bind}" Padding="0" Width="28" Height="28" CornerRadius="14"
                                            HorizontalAlignment="Right" ToolTipService.ToolTip="Añadir a playlist">
                                        <FontIcon Glyph="&#xE8F1;" FontSize="11"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
