<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="KakiEQ_WinUI.Views.ArtistDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:KakiEQ_WinUI.Models"
    xmlns:vm="using:KakiEQ_WinUI.ViewModels"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="240"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Hero Header Banner -->
        <Border Grid.Row="0" Background="#181422" BorderBrush="#251C33" BorderThickness="0,0,0,1">
            <Grid Padding="32,24">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#361556" Offset="0.0"/>
                        <GradientStop Color="#151020" Offset="0.8"/>
                    </LinearGradientBrush>
                </Grid.Background>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="24">
                    <!-- Back Button -->
                    <Button Command="{Binding GoBackCommand}"
                            Background="#22FFFFFF" Foreground="White" Width="42" Height="42"
                            CornerRadius="21" Padding="0">
                        <FontIcon Glyph="&#xE72B;" FontSize="16"/>
                    </Button>

                    <!-- Circular Artist Avatar -->
                    <Border Width="150" Height="150" CornerRadius="75" Background="#262626">
                        <Grid>
                            <FontIcon Glyph="&#xE77B;" FontSize="54" Foreground="#555555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Source="{Binding BannerImagePath}" Stretch="UniformToFill"/>
                        </Grid>
                    </Border>

                    <!-- Info -->
                    <StackPanel VerticalAlignment="Center" Spacing="8">
                        <Border Background="#381E72" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left">
                            <TextBlock Text="ARTISTA" FontSize="11" FontWeight="Bold" Foreground="#D0BCFF"/>
                        </Border>

                        <TextBlock Text="{Binding ArtistName}" FontSize="36" FontWeight="Bold" Foreground="White"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Genre}" FontSize="15" Foreground="#B0B0B0"/>

                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
                            <Button Command="{Binding PlayAlbumCommand}"
                                    Background="#BB86FC" Foreground="#121212"
                                    CornerRadius="20" Padding="20,8" FontWeight="SemiBold">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE768;" FontSize="14"/>
                                    <TextBlock Text="Reproducir Álbum" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Content 3 Columns -->
        <Grid Grid.Row="1" Padding="32,24" ColumnSpacing="28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Albums List -->
            <StackPanel Grid.Column="0" Spacing="12">
                <TextBlock Text="{Binding TotalAlbumsText}" 
                           FontSize="12" FontWeight="Bold" Foreground="#888888"/>

                <ListView ItemsSource="{Binding Albums}"
                          SelectedItem="{Binding SelectedAlbum, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:AlbumItem">
                            <Grid Padding="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="6" Background="#242424">
                                    <Grid>
                                        <FontIcon Glyph="&#xE93C;" FontSize="14" Foreground="#555555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{x:Bind CoverImagePath}" Stretch="UniformToFill"/>
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontSize="13" Foreground="White"
                                           VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <!-- CENTER: Selected Album Tracks -->
            <StackPanel Grid.Column="1" Spacing="12">
                <Grid>
                    <TextBlock Text="{Binding SelectedAlbum.Title, FallbackValue='Pistas del Álbum'}" 
                               FontSize="16" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                </Grid>

                <ListView ItemsSource="{Binding SelectedAlbumTracks}"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="Track_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Track">
                            <Grid Padding="8,8" CornerRadius="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind TrackNumber}" FontSize="12" Foreground="#666666"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind DurationFormatted}" FontSize="12" Foreground="#888888"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <!-- RIGHT: Stats -->
            <StackPanel Grid.Column="2" Spacing="16">
                <TextBlock Text="ESTADÍSTICAS" FontSize="12" FontWeight="Bold" Foreground="#888888"/>

                <Border Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="14" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding TotalAlbums}" FontSize="28" FontWeight="Bold" Foreground="#BB86FC"/>
                        <TextBlock Text="Álbumes" FontSize="12" Foreground="#888888"/>
                    </StackPanel>
                </Border>

                <Border Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="14" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding TotalSongs}" FontSize="28" FontWeight="Bold" Foreground="#03DAC6"/>
                        <TextBlock Text="Canciones" FontSize="12" Foreground="#888888"/>
                    </StackPanel>
                </Border>

                <Border Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="14" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding TotalLength}" FontSize="16" FontWeight="Bold" Foreground="#FFB74D"/>
                        <TextBlock Text="Duración" FontSize="12" Foreground="#888888"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

