<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="KakiEQ_WinUI.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:KakiEQ_WinUI.Models"
    xmlns:vm="using:KakiEQ_WinUI.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel Spacing="28" HorizontalAlignment="Stretch">

            <!-- 1. Hero Welcome Banner (Material 3 Surface Elevation) -->
            <Border Height="200" CornerRadius="20" Background="#1E162A" BorderBrush="#382650" BorderThickness="1">
                <Grid Padding="32">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4A148C" Offset="0.0"/>
                            <GradientStop Color="#181220" Offset="0.7"/>
                            <GradientStop Color="#121212" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Grid.Background>

                    <!-- Background decorative glow -->
                    <Ellipse Width="180" Height="180" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-60,-30,0" Opacity="0.2">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#BB86FC" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                            <Border Background="#381E72" CornerRadius="12" Padding="8,4">
                                <TextBlock Text="KAKI EQ v2.0" FontSize="11" FontWeight="Bold" Foreground="#D0BCFF" />
                            </Border>
                            <Border Background="#1AFFFFFF" CornerRadius="12" Padding="8,4">
                                <TextBlock Text="WinUI 3 &amp; Material Design" FontSize="11" Foreground="#E0E0E0" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="¡Bienvenido a Kaki EQ!" FontSize="32" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
                        <TextBlock Text="Disfruta de tu música con máxima fidelidad y ecualización paramétrica en tiempo real." 
                                   FontSize="14" Foreground="#D0BCFF" Opacity="0.9"/>
                    </StackPanel>

                    <Button HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Command="{Binding PlayRandomCommand}"
                            Background="#BB86FC" Foreground="#121212"
                            CornerRadius="24" Padding="20,10" FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE768;" FontSize="16"/>
                            <TextBlock Text="Reproducir Aleatorio" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 2. Accesos Rápidos (Material Surface Cards) -->
            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Height="72" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="14"
                        Click="NavigateSongs_Click">
                    <Grid Padding="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#261E38" Width="44" Height="44" CornerRadius="10">
                            <FontIcon Glyph="&#xEC4F;" Foreground="#BB86FC" FontSize="20"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Todas las Canciones" FontWeight="SemiBold" FontSize="14" Foreground="White"/>
                            <TextBlock Text="Explora tu biblioteca" FontSize="11" Foreground="#888888"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Grid.Column="1" Height="72" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="14"
                        Click="NavigateAlbums_Click">
                    <Grid Padding="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#1C2D2B" Width="44" Height="44" CornerRadius="10">
                            <FontIcon Glyph="&#xE93C;" Foreground="#03DAC6" FontSize="20"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Colección Álbumes" FontWeight="SemiBold" FontSize="14" Foreground="White"/>
                            <TextBlock Text="Portadas y detalles" FontSize="11" Foreground="#888888"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Grid.Column="2" Height="72" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="14"
                        Click="NavigateArtists_Click">
                    <Grid Padding="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#33241C" Width="44" Height="44" CornerRadius="10">
                            <FontIcon Glyph="&#xE77B;" Foreground="#FFB74D" FontSize="20"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Artistas" FontWeight="SemiBold" FontSize="14" Foreground="White"/>
                            <TextBlock Text="Discografías completas" FontSize="11" Foreground="#888888"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Grid.Column="3" Height="72" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="14"
                        Click="NavigateEqualizer_Click">
                    <Grid Padding="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#2B1E38" Width="44" Height="44" CornerRadius="10">
                            <FontIcon Glyph="&#xE9E9;" Foreground="#CF94FD" FontSize="20"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Ecualizador DSP" FontWeight="SemiBold" FontSize="14" Foreground="White"/>
                            <TextBlock Text="Ajusta frecuencias" FontSize="11" Foreground="#888888"/>
                        </StackPanel>
                    </Grid>
                </Button>
            </Grid>

            <!-- 3. Sugerencias (Material Cards Grid) -->
            <StackPanel Spacing="16">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="Recomendados para ti" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <Border Background="#282828" CornerRadius="8" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="Mix Kaki" FontSize="11" Foreground="#BB86FC"/>
                        </Border>
                    </StackPanel>

                    <Button HorizontalAlignment="Right" Command="{Binding RefreshSuggestionsCommand}"
                            Background="Transparent" BorderThickness="0" Foreground="#888888" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                            <TextBlock Text="Actualizar" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <GridView ItemsSource="{x:Bind ViewModel.SuggestedTracks, Mode=OneWay}"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="SuggestedTrack_ItemClick">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:Track">
                            <Border Width="168" Height="220" Margin="4" CornerRadius="16"
                                    Background="#1A1A1A" BorderBrush="#262626" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="148"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Cover Image or placeholder -->
                                    <Border Grid.Row="0" CornerRadius="16,16,0,0" Background="#222222">
                                        <Grid>
                                            <FontIcon Glyph="&#xEC4F;" FontSize="40" Foreground="#444444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{x:Bind CoverImagePath}" Stretch="UniformToFill"/>
                                        </Grid>
                                    </Border>

                                    <!-- Bottom Info -->
                                    <StackPanel Grid.Row="1" Padding="12,8,12,8" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" Foreground="White"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                        <TextBlock Text="{x:Bind Artist}" FontSize="11" Foreground="#AAAAAA"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>

            <!-- 4. Recientemente Añadidos -->
            <StackPanel Spacing="16" Margin="0,0,0,24">
                <TextBlock Text="Añadidos recientemente" FontSize="20" FontWeight="Bold" Foreground="White"/>

                <ListView ItemsSource="{x:Bind ViewModel.RecentlyAddedTracks, Mode=OneWay}"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="RecentTrack_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Track">
                            <Grid Padding="8,6" CornerRadius="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="40" Height="40" CornerRadius="8" Background="#262626">
                                    <Grid>
                                        <FontIcon Glyph="&#xEC4F;" FontSize="18" Foreground="#555555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{x:Bind CoverImagePath}" Stretch="UniformToFill"/>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind Artist}" FontSize="11" Foreground="#888888" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{x:Bind Album}" FontSize="12" Foreground="#888888"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Column="3" Text="{x:Bind DurationFormatted}" FontSize="12" Foreground="#777777"
                                           VerticalAlignment="Center" Margin="16,0,8,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>

