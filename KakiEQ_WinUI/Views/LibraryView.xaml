<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="KakiEQ_WinUI.Views.LibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:KakiEQ_WinUI.Models"
    xmlns:vm="using:KakiEQ_WinUI.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Controls: Search, Sort, Shuffle All -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Command="{x:Bind ViewModel.ShuffleAllCommand, Mode=OneWay}"
                        Background="#BB86FC" Foreground="#121212"
                        CornerRadius="20" Padding="16,8" FontWeight="SemiBold">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B1;" FontSize="14"/>
                        <TextBlock Text="Aleatorio" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <ComboBox SelectedIndex="{x:Bind ViewModel.SelectedSortIndex, Mode=TwoWay}"
                          Background="#1E1E1E" BorderBrush="#333333" CornerRadius="12"
                          MinWidth="140" Padding="12,6">
                    <ComboBoxItem Content="Título (A-Z)"/>
                    <ComboBoxItem Content="Título (Z-A)"/>
                    <ComboBoxItem Content="Artista / Álbum"/>
                    <ComboBoxItem Content="Año (Más reciente)"/>
                    <ComboBoxItem Content="Duración"/>
                </ComboBox>
            </StackPanel>

            <!-- Search Bar -->
            <TextBox Grid.Column="1" HorizontalAlignment="Right" Width="260" Margin="0,0,16,0"
                     Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Buscar canciones o artistas..."
                     Background="#1E1E1E" BorderBrush="#333333" CornerRadius="12" Padding="12,6">
            </TextBox>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Background="#242424" CornerRadius="12" Padding="10,6">
                    <TextBlock Text="{x:Bind ViewModel.TotalTracksCountFormatted, Mode=OneWay}" 
                               FontSize="12" FontWeight="SemiBold" Foreground="#BB86FC"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Song List (Material Table) -->
        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.FilteredTracks, Mode=OneWay}"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="Song_ItemClick">
            <ListView.Header>
                <Grid Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="#252525">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="2.5*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="#" FontSize="11" FontWeight="Bold" Foreground="#666666" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="TÍTULO" FontSize="11" FontWeight="Bold" Foreground="#888888" Margin="8,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="ARTISTA" FontSize="11" FontWeight="Bold" Foreground="#888888"/>
                    <TextBlock Grid.Column="3" Text="ÁLBUM" FontSize="11" FontWeight="Bold" Foreground="#888888"/>
                    <TextBlock Grid.Column="4" Text="DURACIÓN" FontSize="11" FontWeight="Bold" Foreground="#888888" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="5" Text="" Width="44"/>
                </Grid>
            </ListView.Header>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Track">
                    <Grid Padding="8,8" CornerRadius="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="2.5*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>

                        <!-- Thumbnail -->
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="#222222" HorizontalAlignment="Center">
                            <Grid>
                                <FontIcon Glyph="&#xEC4F;" FontSize="16" Foreground="#444444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{x:Bind CoverImagePath}" Stretch="UniformToFill"/>
                            </Grid>
                        </Border>

                        <!-- Title -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,8,0">
                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="14" Foreground="White" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Artist -->
                        <TextBlock Grid.Column="2" Text="{x:Bind Artist}" FontSize="13" Foreground="#B0B0B0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>

                        <!-- Album -->
                        <TextBlock Grid.Column="3" Text="{x:Bind Album}" FontSize="13" Foreground="#888888"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>

                        <!-- Duration -->
                        <TextBlock Grid.Column="4" Text="{x:Bind DurationFormatted}" FontSize="12" Foreground="#888888"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"/>

                        <!-- Options Menu (3 dots) -->
                        <Button Grid.Column="5" Width="36" Height="36" Background="Transparent" BorderThickness="0"
                                Foreground="#888888" CornerRadius="18" Padding="0" Click="MoreButton_Click" Tag="{x:Bind}">
                            <FontIcon Glyph="&#xE712;" FontSize="14"/>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>

