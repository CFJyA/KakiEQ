<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KakiEQ_WinUI.Views.MultiOutputView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:KakiEQ_WinUI.Models"
    xmlns:vm="using:KakiEQ_WinUI.ViewModels"
    xmlns:helpers="using:KakiEQ_WinUI.Helpers"
    NavigationCacheMode="Required"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,24,28,116">
        <StackPanel Spacing="24" HorizontalAlignment="Stretch" helpers:FluidAnimationHelper.IsFluidLayoutEnabled="True">

            <!-- 1. Header with Title, Badge, Master Volume & Refresh -->
            <Grid helpers:FluidAnimationHelper.IsFluidLayoutEnabled="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Title & Description -->
                <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center" helpers:FluidAnimationHelper.IsFluidLayoutEnabled="True">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Salidas de Audio Simultáneas" FontSize="26" FontWeight="Bold" Foreground="{ThemeResource AppTextPrimary}"/>
                        <Border Background="{ThemeResource AppAccentContainer}" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.ActiveDevicesSummary, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppAccentText}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Transmite música simultáneamente a través de múltiples auriculares, bocinas Bluetooth y salidas de audio por cable con sincronización en tiempo real."
                               FontSize="13" Foreground="{ThemeResource AppTextSubtle}" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Actions on right: Master Volume & Refresh -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center"
                            helpers:FluidAnimationHelper.IsFluidLayoutEnabled="True">
                    <!-- Master Volume Group -->
                    <Border Background="{ThemeResource AppCardBackground}" BorderThickness="0" CornerRadius="16">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Padding="14,8">
                                <FontIcon Glyph="&#xE767;" FontSize="14" Foreground="{ThemeResource AppAccent}" VerticalAlignment="Center"/>
                                <TextBlock Text="Volumen:" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppTextSecondary}" VerticalAlignment="Center"/>
                                <Slider Width="95" Minimum="0" Maximum="100" Value="{x:Bind ViewModel.MasterVolumePercent, Mode=TwoWay}" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind ViewModel.MasterVolumePercentFormatted, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource AppTextPrimary}" Width="36" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Rectangle RadiusX="15" RadiusY="15"
                                       Stroke="{ThemeResource AppBorder}" StrokeThickness="1.2"
                                       Margin="1" UseLayoutRounding="False" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>

                    <!-- Refresh Button -->
                    <Button Command="{x:Bind ViewModel.RefreshDevicesCommand, Mode=OneWay}"
                            Background="{ThemeResource AppSurfaceContainer}" BorderBrush="{ThemeResource AppBorder}" Foreground="{ThemeResource AppAccent}"
                            CornerRadius="16" Padding="14,8" ToolTipService.ToolTip="Volver a buscar dispositivos conectados"
                            helpers:FluidAnimationHelper.HoverMode="Button">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                            <TextBlock Text="Buscar Dispositivos" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. Feature / Status Highlight Banner -->
            <Border Background="{ThemeResource AppHeroBg}" BorderThickness="0" CornerRadius="16"
                    helpers:FluidAnimationHelper.IsFluidLayoutEnabled="True">
                <Grid>
                    <Grid Padding="20,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="6" helpers:FluidAnimationHelper.IsFluidLayoutEnabled="True">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE95B;" FontSize="16" Foreground="{ThemeResource AppAccent}"/>
                                <TextBlock Text="Distribución Multidispositivo de Alto Rendimiento" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource AppTextPrimary}"/>
                            </StackPanel>
                            <TextBlock Text="Diseñado con procesamiento PCM BASS de cero copias de memoria (&lt; 0.5% CPU). Puedes activar tus audífonos y altavoces al mismo tiempo, sincronizarlos y controlar sus volúmenes por separado."
                                       FontSize="12" Foreground="{ThemeResource AppTextSecondary}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Status chips -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="16,0,0,0"
                                    helpers:FluidAnimationHelper.IsFluidLayoutEnabled="True">
                            <Border Background="{ThemeResource AppSurfaceElevated}" CornerRadius="12" Padding="10,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE702;" FontSize="12" Foreground="{ThemeResource AppAccent}"/>
                                    <TextBlock Text="Bluetooth + Alámbrico" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AppTextSecondary}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{ThemeResource AppSurfaceElevated}" CornerRadius="12" Padding="10,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xECAD;" FontSize="12" Foreground="{ThemeResource AppSecondary}"/>
                                    <TextBlock Text="DirectX PCM Sync" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AppTextSecondary}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Rectangle RadiusX="15" RadiusY="15"
                               Stroke="{ThemeResource AppHeroBorder}" StrokeThickness="1.25"
                               Margin="1" UseLayoutRounding="False" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- 2.5 Dispositivo de Audio Virtual Kaki EQ -->
            <Border Background="{ThemeResource AppCardBackground}" BorderThickness="0" CornerRadius="18"
                    helpers:FluidAnimationHelper.HoverMode="Card"
                    helpers:FluidAnimationHelper.IsFluidLayoutEnabled="True">
                <Grid>
                    <Grid Padding="20,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Icon -->
                        <Border Grid.Column="0" Width="52" Height="52" CornerRadius="26" Background="{ThemeResource AppAccentContainer}" Margin="0,0,16,0" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7F6;" FontSize="22" Foreground="{ThemeResource AppAccentText}"/>
                        </Border>

                        <!-- Info -->
                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center" Margin="0,0,16,0"
                                    helpers:FluidAnimationHelper.IsFluidLayoutEnabled="True">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Dispositivo Virtual de Audio Kaki EQ" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource AppTextPrimary}"/>
                                <Border Background="{ThemeResource AppSurfaceElevated}" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.DriverBadgeText, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppAccent}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Registra a Kaki EQ directamente en el menú de salida de audio de Windows 11 para que cualquier programa envíe su sonido aquí y se multiplique en todas tus salidas activas."
                                       FontSize="12" Foreground="{ThemeResource AppTextSubtle}" TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind ViewModel.DriverStatusSummary, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppSecondary}"/>
                        </StackPanel>

                        <!-- Action Controls -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                                    helpers:FluidAnimationHelper.IsFluidLayoutEnabled="True">
                            <!-- If NOT installed: 1-Click Install Button -->
                            <Button Visibility="{x:Bind ViewModel.InstallButtonVisibility, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.InstallDriverCommand, Mode=OneWay}"
                                    Background="{ThemeResource AppAccent}" Foreground="#121212"
                                    CornerRadius="16" Padding="16,8" FontWeight="SemiBold"
                                    ToolTipService.ToolTip="Instalar controlador firmado WHQL sin errores de firma"
                                    helpers:FluidAnimationHelper.HoverMode="Button">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE896;" FontSize="13"/>
                                    <TextBlock Text="Instalar Dispositivo (1 Clic)" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- If INSTALLED: Toggle System Audio Routing -->
                            <ToggleSwitch Visibility="{x:Bind ViewModel.RoutingSwitchVisibility, Mode=OneWay}"
                                          IsOn="{x:Bind ViewModel.IsSystemRoutingActive, Mode=TwoWay}"
                                          Toggled="SystemRoutingToggle_Toggled"
                                          OnContent="Transmitiendo" OffContent="En Pausa"
                                          VerticalAlignment="Center"/>

                            <!-- Open Sound Settings in Windows 11 -->
                            <Button Command="{x:Bind ViewModel.OpenWindowsSoundSettingsCommand, Mode=OneWay}"
                                    Background="{ThemeResource AppSurfaceContainer}" BorderBrush="{ThemeResource AppBorder}"
                                    Foreground="{ThemeResource AppTextPrimary}" CornerRadius="16" Padding="12,8"
                                    ToolTipService.ToolTip="Abrir menú de configuración de sonido de Windows 11"
                                    helpers:FluidAnimationHelper.HoverMode="Button">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE713;" FontSize="13"/>
                                    <TextBlock Text="Ajustes de Windows" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Rectangle RadiusX="17" RadiusY="17"
                               Stroke="{ThemeResource AppBorder}" StrokeThickness="1.2"
                               Margin="1" UseLayoutRounding="False" IsHitTestVisible="False"
                               Tag="UniformBorderRect"/>
                </Grid>
            </Border>

            <!-- 3. Section Title -->
            <Grid Margin="0,4,0,-8" helpers:FluidAnimationHelper.IsFluidLayoutEnabled="True">
                <TextBlock Text="Dispositivos de Audio Detectados" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimary}" VerticalAlignment="Center"/>
            </Grid>

            <!-- 4. Device Cards List -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource AppCardBackground}" BorderThickness="0" CornerRadius="18" Margin="0,0,0,14"
                                helpers:FluidAnimationHelper.HoverMode="Card">
                            <Grid>
                                <Grid Padding="18,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Column 0: Device Icon -->
                                    <Border Grid.Column="0" Width="52" Height="52" CornerRadius="26" Background="{ThemeResource AppAccentSurface}" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <FontIcon Glyph="{Binding IconGlyph}" FontSize="22" Foreground="{ThemeResource AppAccent}"/>
                                    </Border>

                                    <!-- Column 1: Info & Badges -->
                                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimary}" VerticalAlignment="Center"/>
                                            <!-- Primary / Windows Default Badge -->
                                            <Border Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVisConverter}}"
                                                    Background="{ThemeResource AppAccentContainer}" CornerRadius="8" Padding="7,2" VerticalAlignment="Center">
                                                <TextBlock Text="Predeterminado de Windows" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource AppAccentText}"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Subtitle & Status tags -->
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="{Binding DeviceTypeDescription}" FontSize="12" Foreground="{ThemeResource AppTextSubtle}"/>
                                            <TextBlock Text="•" FontSize="12" Foreground="{ThemeResource AppTextMuted}"/>
                                            <TextBlock Text="{Binding Driver}" FontSize="11" Foreground="{ThemeResource AppTextMuted}"/>
                                            <TextBlock Text="•" FontSize="12" Foreground="{ThemeResource AppTextMuted}"/>
                                            <!-- Status indicator text -->
                                            <TextBlock Text="{Binding StatusBadgeText}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{Binding IsEnabled, Converter={StaticResource BoolToAccentConverter}}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Column 2: Controls (Mute, Volume Slider, Latency, Test, Enable Toggle) -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">

                                        <!-- Volume Slider & Mute -->
                                        <Border Background="{ThemeResource AppSurfaceElevated}" CornerRadius="14" Padding="10,6">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <!-- Mute Button -->
                                                <Button Click="MuteButton_Click"
                                                        Background="Transparent" BorderThickness="0" Padding="0" Width="28" Height="28" CornerRadius="14"
                                                        Foreground="{ThemeResource AppTextSecondary}" ToolTipService.ToolTip="Silenciar este dispositivo"
                                                        helpers:FluidAnimationHelper.HoverMode="Icon">
                                                    <FontIcon Glyph="{Binding VolumeIconGlyph}" FontSize="14"/>
                                                </Button>

                                                <!-- Volume Slider -->
                                                <Slider Width="90" Minimum="0" Maximum="100"
                                                        Value="{Binding VolumePercentInt, Mode=TwoWay}"
                                                        ValueChanged="VolumeSlider_ValueChanged"
                                                        VerticalAlignment="Center"/>

                                                <TextBlock Text="{Binding VolumePercentFormatted}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource AppTextPrimary}" Width="36" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Latency / Delay compensation -->
                                        <Border Background="{ThemeResource AppSurfaceElevated}" CornerRadius="14" Padding="10,6">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE823;" FontSize="12" Foreground="{ThemeResource AppTextSubtle}"/>
                                                <TextBlock Text="{Binding LatencyFormatted}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource AppTextSecondary}" Width="65" VerticalAlignment="Center"/>
                                                <Slider Width="65" Minimum="0" Maximum="300" StepFrequency="5"
                                                        Value="{Binding LatencyCompensationMs, Mode=TwoWay}"
                                                        ValueChanged="LatencySlider_ValueChanged"
                                                        ToolTipService.ToolTip="Ajustar retardo en milisegundos para sincronizar Bluetooth"
                                                        VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Test Chime Button -->
                                        <Button Click="TestButton_Click"
                                                Background="{ThemeResource AppSurfaceContainer}" BorderBrush="{ThemeResource AppBorder}"
                                                Foreground="{ThemeResource AppTextPrimary}" CornerRadius="14" Padding="10,6"
                                                ToolTipService.ToolTip="Reproducir tono de prueba armónico (528 Hz)"
                                                helpers:FluidAnimationHelper.HoverMode="Button">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE767;" FontSize="12" Foreground="{ThemeResource AppAccent}"/>
                                                <TextBlock Text="Probar" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Main On/Off Switch -->
                                        <ToggleSwitch IsOn="{Binding IsEnabled, Mode=TwoWay}"
                                                      Toggled="DeviceToggle_Toggled"
                                                      OnContent="Activo" OffContent="Inactivo"
                                                      Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Uniform Vector Border -->
                                <Rectangle RadiusX="17" RadiusY="17"
                                           Stroke="{ThemeResource AppBorder}" StrokeThickness="1.2"
                                           Margin="1" UseLayoutRounding="False" IsHitTestVisible="False"
                                           Tag="UniformBorderRect"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
