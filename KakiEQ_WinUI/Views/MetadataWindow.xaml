<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="KakiEQ_WinUI.Views.MetadataWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:KakiEQ_WinUI.Models"
    mc:Ignorable="d"
    Title="Visualizador y Editor de Metadatos - Kaki EQ">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom TitleBar -->
        <Border Grid.Row="0" x:Name="TitleBarBorder" Background="{ThemeResource AppTitleBarBg}" BorderBrush="{ThemeResource AppTitleBarBorder}" BorderThickness="0,0,0,1">
            <Grid Padding="20,0,140,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                    <FontIcon Glyph="&#xE8EC;" FontSize="15" Foreground="{ThemeResource AppAccent}"/>
                    <TextBlock Text="Visualizador y Editor de Metadatos - Kaki EQ" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimary}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace: 2-Column layout matching AlbumDetail / ArtistDetail -->
        <Grid Grid.Row="1" Padding="24,18,24,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Metadata View & Edit Panel -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
                <StackPanel Spacing="14">
                    
                    <!-- Cover Art Display & Edit button -->
                    <Border Width="330" Height="330" CornerRadius="20" Background="{ThemeResource AppCoverPlaceholderBg}">
                        <Grid>
                            <FontIcon Glyph="&#xEC4F;" FontSize="72" Foreground="{ThemeResource AppCoverPlaceholderFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="CoverImageDisplay" Stretch="UniformToFill"/>
                        </Grid>
                    </Border>

                    <!-- Change Cover Button (Visible in edit mode) -->
                    <Button x:Name="ChangeCoverButton" Click="ChangeCover_Click"
                            HorizontalAlignment="Stretch" Visibility="Collapsed"
                            Background="{ThemeResource AppSurfaceElevated}" BorderBrush="{ThemeResource AppBorder}" BorderThickness="1"
                            CornerRadius="16" Height="36">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                            <FontIcon Glyph="&#xEB9F;" FontSize="13" Foreground="{ThemeResource AppAccent}"/>
                            <TextBlock Text="Cambiar Carátula / Portada..." FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimary}"/>
                        </StackPanel>
                    </Button>

                    <!-- READ-ONLY MODE PANEL -->
                    <StackPanel x:Name="ReadOnlyPanel" Spacing="12">
                        <!-- Format & Tags Pills -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border x:Name="FormatBadge" Background="{ThemeResource AppAccentContainer}" CornerRadius="8" Padding="8,3">
                                <TextBlock x:Name="FormatText" Text="AUDIO" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource AppAccentText}"/>
                            </Border>
                            <Border Background="{ThemeResource AppSurfaceElevated}" BorderBrush="{ThemeResource AppBorder}" BorderThickness="1" CornerRadius="8" Padding="8,3">
                                <TextBlock x:Name="TagTypeText" Text="ID3v2 / Metadata" FontSize="10" Foreground="{ThemeResource AppTextSubtle}"/>
                            </Border>
                        </StackPanel>

                        <!-- Song Title & Artist Header -->
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="DisplayTitleText" Text="Selecciona una canción" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource AppTextPrimary}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DisplayArtistText" Text="Artista" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource AppAccent}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="DisplayAlbumText" Text="Álbum" FontSize="13" Foreground="{ThemeResource AppTextSecondary}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Details Card -->
                        <Border Background="{ThemeResource AppCardBackground}" BorderBrush="{ThemeResource AppBorder}" BorderThickness="1" CornerRadius="14" Padding="14,12">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Año:" FontSize="12" Foreground="{ThemeResource AppTextSubtle}" Width="90"/>
                                    <TextBlock Grid.Column="1" x:Name="DisplayYearText" Text="-" FontSize="12" Foreground="{ThemeResource AppTextPrimary}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Pista:" FontSize="12" Foreground="{ThemeResource AppTextSubtle}" Width="90"/>
                                    <TextBlock Grid.Column="1" x:Name="DisplayTrackNumberText" Text="-" FontSize="12" Foreground="{ThemeResource AppTextPrimary}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Género:" FontSize="12" Foreground="{ThemeResource AppTextSubtle}" Width="90"/>
                                    <TextBlock Grid.Column="1" x:Name="DisplayGenreText" Text="-" FontSize="12" Foreground="{ThemeResource AppTextPrimary}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Compositor:" FontSize="12" Foreground="{ThemeResource AppTextSubtle}" Width="90"/>
                                    <TextBlock Grid.Column="1" x:Name="DisplayComposerText" Text="-" FontSize="12" Foreground="{ThemeResource AppTextPrimary}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Álbum Artista:" FontSize="12" Foreground="{ThemeResource AppTextSubtle}" Width="90"/>
                                    <TextBlock Grid.Column="1" x:Name="DisplayAlbumArtistText" Text="-" FontSize="12" Foreground="{ThemeResource AppTextPrimary}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Letra:" FontSize="12" Foreground="{ThemeResource AppTextSubtle}" Width="90"/>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock x:Name="DisplayLyricsStatusText" Text="Sin letra sincronizada" FontSize="12" Foreground="{ThemeResource AppTextPrimary}"/>
                                        <Button Click="OpenLrcEditor_Click"
                                                Background="{ThemeResource AppSurfaceElevated}" BorderBrush="{ThemeResource AppAccent}" BorderThickness="1"
                                                CornerRadius="10" Padding="8,4" Margin="0,4,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xEC4B;" FontSize="12" Foreground="{ThemeResource AppAccent}"/>
                                                <TextBlock Text="Generar / Sincronizar LRC con Marcas de Tiempo" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimary}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- File Path Card -->
                        <Border Background="{ThemeResource AppSurfaceElevated}" BorderBrush="{ThemeResource AppBorder}" BorderThickness="1" CornerRadius="12" Padding="12,10">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="13" Foreground="{ThemeResource AppAccent}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="DisplayPathText" Text="Ruta del archivo" FontSize="11" Foreground="{ThemeResource AppTextSubtle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Click="OpenInExplorer_Click" Background="Transparent" BorderThickness="0" Padding="4" ToolTipService.ToolTip="Abrir ubicación en Explorador">
                                    <FontIcon Glyph="&#xEC50;" FontSize="12" Foreground="{ThemeResource AppAccent}"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Activate Edit Mode Button -->
                        <Button Click="StartEditMode_Click"
                                HorizontalAlignment="Stretch" Height="42"
                                Background="{ThemeResource AppAccent}" Foreground="#121212"
                                CornerRadius="21">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                <FontIcon Glyph="&#xE70F;" FontSize="14" Foreground="#121212"/>
                                <TextBlock Text="Editar Metadatos" FontSize="13" FontWeight="SemiBold" Foreground="#121212"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- EDIT MODE PANEL (Form fields) -->
                    <StackPanel x:Name="EditModePanel" Spacing="10" Visibility="Collapsed">
                        <Border Background="{ThemeResource AppAccentContainer}" CornerRadius="10" Padding="10,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE70F;" FontSize="14" Foreground="{ThemeResource AppAccentText}"/>
                                <TextBlock Text="Modo Edición Activado" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppAccentText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBox x:Name="EditTitleBox" Header="Título" CornerRadius="8"/>
                        <TextBox x:Name="EditArtistBox" Header="Intérprete / Artista" CornerRadius="8"/>
                        <TextBox x:Name="EditAlbumBox" Header="Álbum" CornerRadius="8"/>
                        
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="EditYearBox" Header="Año" CornerRadius="8"/>
                            <TextBox Grid.Column="1" x:Name="EditTrackBox" Header="Pista #" CornerRadius="8"/>
                        </Grid>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="EditGenreBox" Header="Género" CornerRadius="8"/>
                            <TextBox Grid.Column="1" x:Name="EditDiscBox" Header="Disco #" CornerRadius="8"/>
                        </Grid>

                        <TextBox x:Name="EditAlbumArtistBox" Header="Intérprete del álbum" CornerRadius="8"/>
                        <TextBox x:Name="EditComposerBox" Header="Compositor" CornerRadius="8"/>
                        
                        <StackPanel Spacing="6">
                            <TextBox x:Name="EditLyricsBox" Header="Letra de la Canción (LRC / Texto)" AcceptsReturn="True" TextWrapping="Wrap" Height="100" CornerRadius="8"/>
                            <Button Click="OpenLrcEditor_Click" HorizontalAlignment="Right" Background="{ThemeResource AppSurfaceElevated}" BorderBrush="{ThemeResource AppAccent}" BorderThickness="1" CornerRadius="8" Padding="8,3">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xEC4B;" FontSize="11" Foreground="{ThemeResource AppAccent}"/>
                                    <TextBlock Text="Asistente de Marcas de Tiempo (LRC)" FontSize="11" Foreground="{ThemeResource AppAccent}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Action Buttons: Save & Cancel -->
                        <Grid ColumnSpacing="10" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Click="SaveMetadata_Click"
                                    HorizontalAlignment="Stretch" Height="40"
                                    Background="{ThemeResource AppAccent}" Foreground="#121212"
                                    CornerRadius="20">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                                    <FontIcon Glyph="&#xE74E;" FontSize="13" Foreground="#121212"/>
                                    <TextBlock Text="Guardar Cambios" FontSize="12" FontWeight="SemiBold" Foreground="#121212"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1" Click="CancelEdit_Click"
                                    HorizontalAlignment="Stretch" Height="40"
                                    Background="{ThemeResource AppSurfaceElevated}" Foreground="{ThemeResource AppTextPrimary}"
                                    BorderBrush="{ThemeResource AppBorder}" BorderThickness="1"
                                    CornerRadius="20">
                                <TextBlock Text="Cancelar" FontSize="12" FontWeight="SemiBold"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Subtle Vertical Separator -->
            <Border Grid.Column="1" Width="1" Background="{ThemeResource AppBorder}" Margin="0,4,20,12"/>

            <!-- RIGHT COLUMN: Audio Files List -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Filter & Search Toolbar -->
                <Grid Grid.Row="0" Margin="0,0,0,14" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" x:Name="SearchBox"
                             PlaceholderText="Buscar archivo por título, artista o nombre..."
                             TextChanged="SearchBox_TextChanged"
                             CornerRadius="16" Height="36"/>

                    <TextBlock Grid.Column="1" x:Name="FileCountLabel"
                               Text="0 canciones" FontSize="12" Foreground="{ThemeResource AppTextSubtle}"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="2" Click="OpenExternalFile_Click"
                            Background="{ThemeResource AppSurfaceElevated}" BorderBrush="{ThemeResource AppBorder}" BorderThickness="1"
                            CornerRadius="16" Height="36" Padding="12,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xED25;" FontSize="13" Foreground="{ThemeResource AppAccent}"/>
                            <TextBlock Text="Abrir archivo externo..." FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Files Table / List -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Table Column Header -->
                    <Grid Grid.Row="0" Margin="12,0,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="#" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppTextSubtle}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="TÍTULO / ARCHIVO" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppTextSubtle}"/>
                        <TextBlock Grid.Column="2" Text="ARTISTA" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppTextSubtle}"/>
                        <TextBlock Grid.Column="3" Text="ÁLBUM" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppTextSubtle}"/>
                        <TextBlock Grid.Column="4" Text="DURACIÓN" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppTextSubtle}" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Tracks ListView -->
                    <ListView Grid.Row="1" x:Name="TracksListView"
                              SelectionMode="Single"
                              SelectionChanged="TracksListView_SelectionChanged"
                              Padding="0,0,4,16">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Track">
                                <Grid Padding="8,8" CornerRadius="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{x:Bind DisplayIndexFormatted}" FontSize="12" Foreground="{ThemeResource AppTextMuted}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AppTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{x:Bind Artist}" FontSize="12" Foreground="{ThemeResource AppTextSecondary}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Grid.Column="3" Text="{x:Bind Album}" FontSize="12" Foreground="{ThemeResource AppTextMuted}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Grid.Column="4" Text="{x:Bind DurationFormatted}" FontSize="12" Foreground="{ThemeResource AppTextMuted}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Grid>

        <!-- LRC TIMESTAMP GENERATOR MODAL OVERLAY -->
        <Grid x:Name="LrcGeneratorOverlay"
              Grid.RowSpan="2"
              Visibility="Collapsed"
              Background="{ThemeResource AppOverlayBg}"
              Canvas.ZIndex="300"
              Padding="32">
            <Border Background="{ThemeResource AppCardBackground}"
                    BorderBrush="{ThemeResource AppBorder}"
                    BorderThickness="1"
                    CornerRadius="22"
                    MaxWidth="820"
                    MaxHeight="640"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid Padding="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title & close -->
                        <RowDefinition Height="Auto"/> <!-- Audio playback strip -->
                        <RowDefinition Height="*"/>    <!-- Text input / Synchronizer lines -->
                        <RowDefinition Height="Auto"/> <!-- Action bar -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEC4B;" FontSize="18" Foreground="{ThemeResource AppAccent}" VerticalAlignment="Center"/>
                                <TextBlock Text="Sincronizador de Letras LRC (Marcas de Tiempo)" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource AppTextPrimary}"/>
                            </StackPanel>
                            <TextBlock x:Name="LrcTrackInfoText" Text="Canción - Artista" FontSize="12" Foreground="{ThemeResource AppTextSubtle}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1" Click="CloseLrcEditor_Click"
                                Width="36" Height="36" CornerRadius="18" Background="Transparent" BorderThickness="0" Padding="0">
                            <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="{ThemeResource AppTextPrimary}"/>
                        </Button>
                    </Grid>

                    <!-- Mini Playback Strip -->
                    <Border Grid.Row="1" Background="{ThemeResource AppSurfaceElevated}" BorderBrush="{ThemeResource AppBorder}" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="0,0,0,14">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" x:Name="LrcPlayPauseBtn" Click="LrcPlayPause_Click"
                                    Width="38" Height="38" CornerRadius="19" Background="{ThemeResource AppAccent}" Foreground="#121212" Padding="0">
                                <FontIcon x:Name="LrcPlayPauseIcon" Glyph="&#xE768;" FontSize="14"/>
                            </Button>

                            <TextBlock Grid.Column="1" x:Name="LrcCurrentTimeText" Text="00:00.00" FontSize="13" FontWeight="Bold" Foreground="{ThemeResource AppAccent}" VerticalAlignment="Center" FontFamily="Consolas"/>

                            <Slider Grid.Column="2" x:Name="LrcProgressSlider" ValueChanged="LrcProgressSlider_ValueChanged" VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="3" x:Name="LrcTotalTimeText" Text="00:00.00" FontSize="12" Foreground="{ThemeResource AppTextSubtle}" VerticalAlignment="Center" FontFamily="Consolas"/>
                        </Grid>
                    </Border>

                    <!-- Main Editor Workspace (Toggle between Raw Text and Sync Grid) -->
                    <Grid Grid.Row="2" Margin="0,0,0,14">
                        <!-- Step 1: Plain text / raw editor -->
                        <Grid x:Name="LrcRawView" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="1. Pega o escribe aquí la letra de la canción (un verso por línea):" FontSize="12" Foreground="{ThemeResource AppTextSubtle}" Margin="0,0,0,6"/>

                            <TextBox Grid.Row="1" x:Name="LrcRawTextBox" AcceptsReturn="True" TextWrapping="Wrap"
                                     PlaceholderText="Pega aquí la letra de la canción..."
                                     FontFamily="Consolas" FontSize="13" CornerRadius="10"/>

                            <Button Grid.Row="2" Click="LrcStartSync_Click" Margin="0,10,0,0"
                                    HorizontalAlignment="Right" Background="{ThemeResource AppAccent}" Foreground="#121212" CornerRadius="16" Padding="16,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE768;" FontSize="12"/>
                                    <TextBlock Text="Comenzar a Marcar Tiempos" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Step 2: Interactive Sync View with Line Highlighting -->
                        <Grid x:Name="LrcSyncView" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                                <TextBlock Text="Presiona 'Marcar Tiempo' (o Espacio) en el momento exacto en que comienza cada verso:" FontSize="12" Foreground="{ThemeResource AppTextSubtle}" VerticalAlignment="Center"/>
                                <Button Click="LrcBackToRaw_Click" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource AppAccent}" Padding="4,2">
                                    <TextBlock Text="Editar texto" FontSize="11" TextDecorations="Underline"/>
                                </Button>
                            </StackPanel>

                            <ListView Grid.Row="1" x:Name="LrcLinesListView"
                                      SelectionMode="Single"
                                      IsItemClickEnabled="True"
                                      ItemClick="LrcLine_ItemClick"
                                      Background="{ThemeResource AppSurfaceElevated}"
                                      BorderBrush="{ThemeResource AppBorder}"
                                      BorderThickness="1"
                                      CornerRadius="12"
                                      Padding="6">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:LrcLine">
                                        <Grid Padding="8,4" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Background="{ThemeResource AppAccentContainer}" CornerRadius="8" Padding="6,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{x:Bind TimestampFormatted}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppAccentText}" FontFamily="Consolas"/>
                                            </Border>

                                            <TextBlock Grid.Column="1" Text="{x:Bind Text}" FontSize="13" Foreground="{ThemeResource AppTextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                            <Button Grid.Column="2" Click="LrcStampSingleLine_Click" Tag="{x:Bind}" Background="Transparent" BorderThickness="0" Padding="4" ToolTipService.ToolTip="Establecer tiempo actual aquí">
                                                <FontIcon Glyph="&#xEC4B;" FontSize="11" Foreground="{ThemeResource AppAccent}"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Big Stamp Button -->
                            <Button Grid.Row="2" Click="LrcStampCurrentLine_Click"
                                    HorizontalAlignment="Stretch" Height="48" Margin="0,10,0,0"
                                    Background="{ThemeResource AppAccent}" Foreground="#121212" CornerRadius="24">
                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xEC4B;" FontSize="16" Foreground="#121212"/>
                                    <TextBlock Text="MARCAR TIEMPO ACTUAL EN ESTA LÍNEA (ESPACIO)" FontWeight="Bold" FontSize="13" Foreground="#121212"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>

                    <!-- Footer Action Buttons -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Click="CloseLrcEditor_Click"
                                Background="Transparent" BorderThickness="1" BorderBrush="{ThemeResource AppBorder}"
                                CornerRadius="18" Padding="16,8">
                            <TextBlock Text="Cancelar" FontSize="12" Foreground="{ThemeResource AppTextPrimary}"/>
                        </Button>

                        <Button Grid.Column="2" Click="SaveLrc_Click"
                                Background="{ThemeResource AppAccent}" Foreground="#121212"
                                CornerRadius="18" Padding="20,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74E;" FontSize="13" Foreground="#121212"/>
                                <TextBlock Text="Guardar Letra y Generar LRC" FontWeight="Bold" FontSize="12" Foreground="#121212"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
