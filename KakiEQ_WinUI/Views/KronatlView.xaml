<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KakiEQ_WinUI.Views.KronatlView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:KakiEQ_WinUI.Models"
    xmlns:vm="using:KakiEQ_WinUI.ViewModels"
    xmlns:helpers="using:KakiEQ_WinUI.Helpers"
    NavigationCacheMode="Required"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,24,28,116">
        <StackPanel Spacing="24" HorizontalAlignment="Stretch" helpers:FluidAnimationHelper.IsFluidLayoutEnabled="True">

            <!-- 1. Header with Title & Clean Lore Description (Without Xiuhpohualli) -->
            <Grid helpers:FluidAnimationHelper.IsFluidLayoutEnabled="True">
                <StackPanel Spacing="6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Kronatl" FontSize="28" FontWeight="ExtraBold" Foreground="{ThemeResource AppTextPrimary}"/>
                        <Border Background="#2B1842" BorderBrush="#BB86FC" BorderThickness="1" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                            <TextBlock Text="RECAP POR ESTACIÓN" FontSize="11" FontWeight="Bold" Foreground="#D0BCFF"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="El flujo del tiempo y las frecuencias que marcaron tu vida. Estadísticas locales de alta fidelidad organizadas por temporadas."
                               FontSize="13" Foreground="{ThemeResource AppTextSubtle}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <!-- 2. Feature Lore Banner Themed for Current Ongoing Cycle -->
            <Border Background="#1C1422" BorderThickness="0" CornerRadius="18"
                    helpers:FluidAnimationHelper.IsFluidLayoutEnabled="True">
                <Grid>
                    <Grid Padding="24,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7C0;" FontSize="16" Foreground="#FF7043"/>
                                <TextBlock Text="Temporada en Curso: Otoño 2026" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource AppTextPrimary}"/>
                            </StackPanel>
                            <TextBlock Text="Septiembre – Noviembre 2026. Esta es la primera temporada en la historia de Kaki EQ. Se liberará oficialmente en 3 semanas (1 de Diciembre), pero ya puedes abrir El Códice en tiempo real para ver tus estadísticas y escuchar tu música favorita."
                                       FontSize="12" Foreground="{ThemeResource AppTextSecondary}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Seasonal Palette Chips -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Border Background="#3B1812" BorderBrush="#FF7043" BorderThickness="1" CornerRadius="12" Padding="12,6">
                                <TextBlock Text="🍂 Otoño (Naranjas, Verdes y Morados)" FontSize="11" FontWeight="SemiBold" Foreground="#FF7043"/>
                            </Border>
                            <Border Background="#1C1630" BorderBrush="#BB86FC" BorderThickness="1" CornerRadius="12" Padding="12,6">
                                <TextBlock Text="✨ Anual 2026 (Dorado &amp; Morado Kaki)" FontSize="11" FontWeight="SemiBold" Foreground="#D0BCFF"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Rectangle RadiusX="17" RadiusY="17"
                               Stroke="#4A2624" StrokeThickness="1.2"
                               Margin="1" UseLayoutRounding="False" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- 3. Section Title -->
            <Grid Margin="0,4,0,-8">
                <TextBlock Text="Códices de la Estación" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimary}" VerticalAlignment="Center"/>
            </Grid>

            <!-- 4. Seasons Cards List -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.Seasons, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:KronatlSeason">
                        <Border Background="{x:Bind CardBackground}" BorderBrush="{x:Bind CardBorderBrush}" BorderThickness="1.2" CornerRadius="20" Margin="0,0,0,16"
                                helpers:FluidAnimationHelper.HoverMode="Card">
                            <Grid>
                                <!-- Atmospheric Festival Particles Overlay -->
                                <Image Source="{x:Bind ParticlesImagePath}" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Opacity="0.92" IsHitTestVisible="False"/>

                                <Grid Padding="20,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Column 0: Seasonal Emblem (Skull for Otoño / Bonfire for Anual) -->
                                    <Border Grid.Column="0" Width="72" Height="72" CornerRadius="36" Margin="0,0,18,0" VerticalAlignment="Center">
                                        <Image Source="{x:Bind EmblemImagePath}" Width="72" Height="72" Stretch="Uniform"/>
                                    </Border>

                                    <!-- Column 1: Original Informative Data + Rich Seasonal Theme -->
                                    <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center" Margin="0,0,18,0">
                                        <!-- Title + Status Badge + Seasonal & Palette Badges Row -->
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Title}" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>

                                            <!-- Original Status Badge (e.g. EN CURSO · SE LIBERA EN 3 SEMANAS (1 de diciembre)) -->
                                            <Border Background="#26161C" BorderBrush="{x:Bind AccentColor}" BorderThickness="1.2" CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind StatusBadgeText}" FontSize="11" FontWeight="Bold" Foreground="{x:Bind AccentColor}"/>
                                            </Border>

                                            <!-- Seasonal Pill (e.g. DÍA DE MUERTOS · OTOÑO / CELEBRACIÓN · ANUAL) -->
                                            <Border Background="{x:Bind AccentColor}" CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind SeasonalBadgeText}" FontSize="11" FontWeight="Bold" Foreground="#000000"/>
                                            </Border>

                                            <!-- Original Palette Description Pill (e.g. Naranjas, Verdes y Morados) -->
                                            <Border Background="#201930" BorderBrush="#3A2B52" BorderThickness="1" CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind PaletteDescription}" FontSize="11" FontWeight="SemiBold" Foreground="#D0BCFF"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Original Lore Description -->
                                        <TextBlock Text="{x:Bind LoreDescription}" FontSize="12.5" Foreground="#C8C2D6" TextWrapping="Wrap" MaxWidth="860"/>

                                        <!-- Quick Stats Pills -->
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                            <Border Background="#252129" CornerRadius="12" Padding="10,4">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE823;" FontSize="11" Foreground="{x:Bind AccentColor}"/>
                                                    <TextBlock Text="{x:Bind Stats.TotalListeningFormatted}" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="#252129" CornerRadius="12" Padding="10,4">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE735;" FontSize="11" Foreground="{x:Bind AccentColor}"/>
                                                    <TextBlock Text="{x:Bind Stats.TopTrackTitle}" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="#252129" CornerRadius="12" Padding="10,4">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE77B;" FontSize="11" Foreground="{x:Bind AccentColor}"/>
                                                    <TextBlock Text="{x:Bind Stats.TopArtist}" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="#16291E" CornerRadius="12" Padding="10,4">
                                                <TextBlock Text="{x:Bind Stats.FidelitySummary}" FontSize="11" FontWeight="Bold" Foreground="#00E676"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Column 2: Action Buttons (Abrir Códice, Top 30) -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <!-- Open Codex Button with Season Theme -->
                                        <Button Click="OpenCodex_Click" Tag="{Binding}"
                                                Background="{x:Bind OpenCodexBackground}" Foreground="{x:Bind OpenCodexForeground}"
                                                CornerRadius="18" Padding="16,8" FontWeight="Bold"
                                                ToolTipService.ToolTip="Abrir El Códice interactivo estilo Recap en pantalla completa"
                                                helpers:FluidAnimationHelper.HoverMode="Button">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE823;" FontSize="13" Foreground="{x:Bind OpenCodexForeground}"/>
                                                <TextBlock Text="Abrir Códice" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Play Top 30 Button -->
                                        <Button Click="PlayTop30_Click" Tag="{Binding}"
                                                Background="#1F1D24" BorderBrush="#383540" BorderThickness="1"
                                                Foreground="#FFFFFF" CornerRadius="18" Padding="14,8"
                                                ToolTipService.ToolTip="Reproducir las pistas de la temporada"
                                                helpers:FluidAnimationHelper.HoverMode="Button">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="{x:Bind AccentColor}"/>
                                                <TextBlock Text="Top 30" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
