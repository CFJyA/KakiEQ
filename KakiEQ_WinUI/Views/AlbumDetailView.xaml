<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KakiEQ_WinUI.Views.AlbumDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:KakiEQ_WinUI.Models"
    xmlns:vm="using:KakiEQ_WinUI.ViewModels"
    xmlns:helpers="using:KakiEQ_WinUI.Helpers"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid Padding="24,18,24,0" helpers:FluidAnimationHelper.IsFluidLayoutEnabled="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT COLUMN: Back button, Enlarged Cover art (330px), Album info, Stats, Actions, More from artist tiles (all 330px) -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,116">
            <StackPanel Width="330" HorizontalAlignment="Left" Spacing="14" helpers:FluidAnimationHelper.IsFluidLayoutEnabled="True">
                <!-- Back Button -->
                <Button Command="{Binding GoBackCommand}"
                        Background="#22FFFFFF" Foreground="{ThemeResource AppTextPrimary}" Width="40" Height="40"
                        CornerRadius="20" Padding="0" HorizontalAlignment="Left"
                        helpers:FluidAnimationHelper.HoverMode="Icon"
                        ToolTipService.ToolTip="Regresar a Álbumes">
                    <FontIcon Glyph="&#xE72B;" FontSize="15"/>
                </Button>

                <!-- Cover Artwork (Enlarged to 330x330, perfectly matching the stats and tiles below) -->
                <Grid Width="330" Height="330" CornerRadius="22" Background="{ThemeResource AppCoverPlaceholderBg}"
                      helpers:FluidAnimationHelper.IsFluidLayoutEnabled="True">
                    <FontIcon Glyph="&#xE93C;" FontSize="72" Foreground="{ThemeResource AppCoverPlaceholderFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image Source="{Binding CoverHeroSource}" Stretch="UniformToFill"/>
                    <Rectangle RadiusX="21" RadiusY="21" Stroke="{ThemeResource AppBorder}" StrokeThickness="1.15" Margin="1" UseLayoutRounding="False" IsHitTestVisible="False"/>
                </Grid>

                <!-- Title, Artist & Pill Badge (Artist placed strictly below Album Title) -->
                <StackPanel Spacing="4" Margin="0,2,0,0">
                    <Border Background="{ThemeResource AppAccentContainer}" CornerRadius="8" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,4">
                        <TextBlock Text="{Binding ReleaseTypeBadgeText}" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource AppAccentText}"/>
                    </Border>
                    <!-- Album Title -->
                    <TextBlock Text="{Binding AlbumTitle}" FontSize="26" FontWeight="Bold" Foreground="{ThemeResource AppTextPrimary}"
                               TextWrapping="Wrap" MaxLines="2"/>
                    <!-- Artist Name DEBAJO del nombre del album -->
                    <TextBlock Text="{Binding ArtistName}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource AppAccent}"
                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Information Subtitle -->
                <TextBlock Text="INFORMACIÓN" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppTextSubtle}" Margin="0,4,0,0"/>

                <!-- Stat Cards (2 columns, 330px total width) -->
                <Grid ColumnSpacing="10" Width="330">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Canciones -->
                    <Grid Grid.Column="0" Background="{ThemeResource AppCardBackground}" CornerRadius="14">
                        <Rectangle RadiusX="13" RadiusY="13" Stroke="{ThemeResource AppBorder}" StrokeThickness="1.15" Margin="1" UseLayoutRounding="False" IsHitTestVisible="False"/>
                        <StackPanel Spacing="2" Padding="14,10">
                            <TextBlock Text="{Binding TotalSongs}" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource AppAccent}"/>
                            <TextBlock Text="Canciones" FontSize="11" Foreground="{ThemeResource AppTextSubtle}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Duración Total -->
                    <Grid Grid.Column="1" Background="{ThemeResource AppCardBackground}" CornerRadius="14">
                        <Rectangle RadiusX="13" RadiusY="13" Stroke="{ThemeResource AppBorder}" StrokeThickness="1.15" Margin="1" UseLayoutRounding="False" IsHitTestVisible="False"/>
                        <StackPanel Spacing="2" Padding="14,10">
                            <TextBlock Text="{Binding TotalLength}" FontSize="17" FontWeight="Bold" Foreground="{ThemeResource AppSecondary}"/>
                            <TextBlock Text="Duración Total" FontSize="11" Foreground="{ThemeResource AppTextSubtle}"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Action Buttons: Reproducir Todo & Añadir a Playlist (2 columns, 330px total width) -->
                <Grid ColumnSpacing="10" Width="330" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{Binding PlayAllCommand}"
                            HorizontalAlignment="Stretch" Height="40"
                            Background="{ThemeResource AppAccent}" Foreground="#121212"
                            CornerRadius="20" Padding="12,0"
                            helpers:FluidAnimationHelper.HoverMode="Fab">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="7">
                            <FontIcon Glyph="&#xE768;" FontSize="13" Foreground="#121212"/>
                            <TextBlock Text="Reproducir Todo" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#121212"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1" x:Name="AddAlbumToPlaylistBtn"
                            Click="AddAlbumToPlaylist_Click"
                            HorizontalAlignment="Stretch" Height="40"
                            Background="{ThemeResource AppSurfaceElevated}" Foreground="{ThemeResource AppTextPrimary}"
                            BorderBrush="{ThemeResource AppBorder}" BorderThickness="1"
                            CornerRadius="20" Padding="10,0"
                            helpers:FluidAnimationHelper.HoverMode="Button">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                            <FontIcon Glyph="&#xE8F1;" FontSize="13" Foreground="{ThemeResource AppAccent}"/>
                            <TextBlock Text="Añadir a Playlist" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- MÁS DE ESTE ARTISTA (Tiles en cuadrícula que coinciden con los 330px de ancho) -->
                <StackPanel Spacing="10" Margin="0,10,0,16" Width="330">
                    <TextBlock Text="MÁS DE ESTE ARTISTA" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppTextSubtle}"/>

                    <GridView ItemsSource="{Binding MoreByArtist}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="MoreAlbum_ItemClick"
                              Padding="0"
                              HorizontalAlignment="Left"
                              Width="330"
                              helpers:FluidAnimationHelper.EnableGridViewReflow="True">
                        <GridView.ItemContainerTransitions>
                            <TransitionCollection>
                                <RepositionThemeTransition IsStaggeringEnabled="False"/>
                            </TransitionCollection>
                        </GridView.ItemContainerTransitions>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="0,0,8,10"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="MinWidth" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GridViewItem">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                              Margin="{TemplateBinding Padding}"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="161" ItemHeight="205"/>
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:AlbumItem">
                                <Grid Background="{ThemeResource AppCardBackground}" CornerRadius="12"
                                      helpers:FluidAnimationHelper.HoverMode="Card"
                                      helpers:FluidAnimationHelper.IsFluidLayoutEnabled="True">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="148"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Cover image tile -->
                                        <Border Grid.Row="0" CornerRadius="12,12,0,0" Background="{ThemeResource AppCoverPlaceholderBg}">
                                            <Grid>
                                                <FontIcon Glyph="&#xE93C;" FontSize="28" Foreground="{ThemeResource AppCoverPlaceholderFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{x:Bind CoverCardSource, Mode=OneWay}" Stretch="UniformToFill"/>
                                            </Grid>
                                        </Border>

                                        <!-- Title below tile -->
                                        <StackPanel Grid.Row="1" Padding="8,5" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Title}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimary}"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                            <TextBlock Text="{x:Bind Artist}" FontSize="10" Foreground="{ThemeResource AppTextSubtle}"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                        </StackPanel>
                                    </Grid>
                                    <Rectangle Tag="UniformBorderRect" RadiusX="11" RadiusY="11" Stroke="{ThemeResource AppBorder}" StrokeThickness="1.15" Margin="1" UseLayoutRounding="False" IsHitTestVisible="False"/>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Subtle Vertical Separator -->
        <Border Grid.Column="1" Width="1" Background="{ThemeResource AppBorder}" Margin="0,4,20,116"/>

        <!-- RIGHT COLUMN: Tracklist (Full height, scrollable, no clipping, aesthetic alignment) -->
        <Grid Grid.Column="2" helpers:FluidAnimationHelper.IsFluidLayoutEnabled="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Row with column hints -->
            <Grid Grid.Row="0" Margin="10,8,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="124"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="#" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppTextSubtle}" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding TotalSongsText}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppTextSubtle}"/>
                <TextBlock Grid.Column="2" Text="CLAVE · BPM" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppTextSubtle}" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="3" Text="DURACIÓN" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppTextSubtle}" HorizontalAlignment="Right"/>
            </Grid>

            <!-- Bounded ListView that scrolls completely! -->
            <ListView Grid.Row="1"
                      ItemsSource="{Binding DisplayTracks}"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="Track_ItemClick"
                      ContainerContentChanging="TracksListView_ContainerContentChanging"
                      Padding="0,0,4,116"
                      helpers:FluidAnimationHelper.EnableGridViewReflow="True">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Track">
                        <Grid>
                            <!-- Spotify-style Disc Separator Header (Only visible when album has >1 disc) -->
                            <Grid Padding="10,14,10,6" Visibility="{x:Bind DiscHeaderRowVisibility, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE93C;" FontSize="15" Foreground="{ThemeResource AppTextSecondary}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind DiscHeaderTitle, Mode=OneWay}" FontSize="14" FontWeight="Bold"
                                           Foreground="{ThemeResource AppTextSecondary}" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Standard Track Row -->
                            <Grid Padding="10,8" CornerRadius="8" Background="Transparent"
                                  Visibility="{x:Bind NormalTrackRowVisibility, Mode=OneWay}"
                                  RightTapped="TrackRow_RightTapped" Tag="{x:Bind}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="124"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>

                                <!-- Track Number -->
                                <TextBlock Grid.Column="0" Text="{x:Bind TrackNumber}" FontSize="12" Foreground="{ThemeResource AppTextMuted}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                <!-- Song Title -->
                                <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{ThemeResource AppTextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>

                                <!-- Camelot Pill Badge + Discrete BPM: [ 8A ] 118 BPM -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                            VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0">
                                    <Border Background="{x:Bind CamelotBackgroundBrush, Mode=OneWay}"
                                            Visibility="{x:Bind HasCamelotVisibility, Mode=OneWay}"
                                            CornerRadius="8" Padding="7,2" MinWidth="30" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind CamelotKeyFormatted, Mode=OneWay}"
                                                   Foreground="{x:Bind CamelotForegroundBrush, Mode=OneWay}"
                                                   FontSize="11" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{x:Bind BpmFormatted, Mode=OneWay}"
                                               Visibility="{x:Bind HasBpmVisibility, Mode=OneWay}"
                                               FontSize="11" Foreground="{ThemeResource AppTextMuted}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Duration -->
                                <TextBlock Grid.Column="3" Text="{x:Bind DurationFormatted}" FontSize="12" Foreground="{ThemeResource AppTextMuted}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                <!-- Options Menu (3 dots) -->
                                <Button Grid.Column="4" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource AppTextSubtle}"
                                        Click="MoreButton_Click" Tag="{x:Bind}" Padding="0" Width="30" Height="30" CornerRadius="15"
                                        HorizontalAlignment="Right" ToolTipService.ToolTip="Más opciones"
                                        helpers:FluidAnimationHelper.HoverMode="Icon">
                                    <FontIcon Glyph="&#xE712;" FontSize="13"/>
                                </Button>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
