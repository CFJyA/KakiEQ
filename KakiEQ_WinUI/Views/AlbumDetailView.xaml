<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="KakiEQ_WinUI.Views.AlbumDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:KakiEQ_WinUI.Models"
    xmlns:vm="using:KakiEQ_WinUI.ViewModels"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="240"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Hero Header Banner -->
        <Border Grid.Row="0" Background="#181422" BorderBrush="#251C33" BorderThickness="0,0,0,1">
            <Grid Padding="32,24">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2C124D" Offset="0.0"/>
                        <GradientStop Color="#161220" Offset="0.8"/>
                    </LinearGradientBrush>
                </Grid.Background>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="24">
                    <!-- Back Button -->
                    <Button Command="{Binding GoBackCommand}"
                            Background="#22FFFFFF" Foreground="White" Width="42" Height="42"
                            CornerRadius="21" Padding="0">
                        <FontIcon Glyph="&#xE72B;" FontSize="16"/>
                    </Button>

                    <!-- Big Cover Art -->
                    <Border Width="160" Height="160" CornerRadius="16" Background="#262626">
                        <Grid>
                            <FontIcon Glyph="&#xE93C;" FontSize="48" Foreground="#555555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Source="{Binding CoverImagePath}" Stretch="UniformToFill"/>
                        </Grid>
                    </Border>

                    <!-- Album Info -->
                    <StackPanel VerticalAlignment="Center" Spacing="8">
                        <Border Background="#381E72" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left">
                            <TextBlock Text="ÁLBUM" FontSize="11" FontWeight="Bold" Foreground="#D0BCFF"/>
                        </Border>

                        <TextBlock Text="{Binding AlbumTitle}" FontSize="32" FontWeight="Bold" Foreground="White"
                                   TextTrimming="CharacterEllipsis" MaxLines="2"/>
                        <TextBlock Text="{Binding ArtistName}" FontSize="16" Foreground="#B0B0B0" FontWeight="SemiBold"/>

                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
                            <Button Command="{Binding PlayAllCommand}"
                                    Background="#BB86FC" Foreground="#121212"
                                    CornerRadius="20" Padding="20,8" FontWeight="SemiBold">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE768;" FontSize="14"/>
                                    <TextBlock Text="Reproducir Todo" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Content: Tracklist, More By Artist, Stats -->
        <Grid Grid.Row="1" Padding="32,24" ColumnSpacing="28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Tracklist -->
            <StackPanel Grid.Column="0" Spacing="12">
                <TextBlock Text="{Binding TotalSongsText}" 
                           FontSize="12" FontWeight="Bold" Foreground="#888888"/>

                <ListView ItemsSource="{Binding Tracks}"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="Track_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Track">
                            <Grid Padding="8,8" CornerRadius="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind TrackNumber}" FontSize="12" Foreground="#666666"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind DurationFormatted}" FontSize="12" Foreground="#888888"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <!-- CENTER: More by artist -->
            <StackPanel Grid.Column="1" Spacing="12">
                <TextBlock Text="MÁS DE ESTE ARTISTA" FontSize="12" FontWeight="Bold" Foreground="#888888"/>

                <GridView ItemsSource="{Binding MoreByArtist}"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="MoreAlbum_ItemClick">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:AlbumItem">
                            <Border Width="100" Height="100" Margin="4" CornerRadius="12" Background="#242424">
                                <Grid>
                                    <FontIcon Glyph="&#xE93C;" FontSize="28" Foreground="#555555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image Source="{x:Bind CoverImagePath}" Stretch="UniformToFill"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>

            <!-- RIGHT: Stats Cards -->
            <StackPanel Grid.Column="2" Spacing="16">
                <TextBlock Text="INFORMACIÓN" FontSize="12" FontWeight="Bold" Foreground="#888888"/>

                <Border Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="14" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding TotalSongs}" FontSize="28" FontWeight="Bold" Foreground="#BB86FC"/>
                        <TextBlock Text="Canciones" FontSize="12" Foreground="#888888"/>
                    </StackPanel>
                </Border>

                <Border Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="14" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding TotalLength}" FontSize="18" FontWeight="Bold" Foreground="#03DAC6"/>
                        <TextBlock Text="Duración Total" FontSize="12" Foreground="#888888"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

