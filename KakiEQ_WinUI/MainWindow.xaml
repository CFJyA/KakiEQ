<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="KakiEQ_WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:KakiEQ_WinUI.Models"
    xmlns:vm="using:KakiEQ_WinUI.ViewModels"
    xmlns:helpers="using:KakiEQ_WinUI.Helpers"
    mc:Ignorable="d"
    Title="Kaki EQ">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>  <!-- 0: Custom Top Navigation / TitleBar -->
            <RowDefinition Height="*"/>   <!-- 1: Main Workspace: Floating Sidebar + Dynamic View Content -->
            <RowDefinition Height="Auto"/> <!-- 2: Floating Bottom Player Bar -->
        </Grid.RowDefinitions>

        <!-- 0. TOP NAVIGATION BAR (Material 3 Top App Bar) -->
        <Border Grid.Row="0" x:Name="AppTitleBar" Background="{ThemeResource AppTitleBarBg}" BorderBrush="{ThemeResource AppTitleBarBorder}" BorderThickness="0,0,0,1" Height="58">
            <Grid Padding="20,0,140,0"> <!-- Right padding leaves room for native caption buttons -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand / Logo -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                    <Border Width="36" Height="36" CornerRadius="11">
                        <Grid>
                            <Image x:Name="AppLogoImage" Source="ms-appx:///Assets/Kaki_Oficial_Blanco.png" Width="32" Height="32" Stretch="Uniform"/>
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Kaki EQ" FontWeight="Bold" FontSize="17" Foreground="{ThemeResource AppTextPrimary}"/>
                        <TextBlock Text="Music Player" FontSize="10" Foreground="{ThemeResource AppTextSubtle}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center Drag Handle Pill (Mockup visual touch) -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Width="44" Height="4" CornerRadius="2" Background="#26FFFFFF" Opacity="0.7"/>

                <!-- Right Action: Scanning Indicator & Ajustes Submenu -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                    <!-- Scanning Spinner -->
                    <ProgressRing IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                                  Width="18" Height="18" Foreground="#BB86FC"/>
                    <TextBlock Text="{x:Bind ViewModel.ScanStatusText, Mode=OneWay}"
                               FontSize="11" Foreground="#BB86FC" VerticalAlignment="Center"
                               Visibility="{x:Bind ViewModel.ScanningVisibility, Mode=OneWay}"/>

                    <!-- Botón Metadatos -->
                    <Button Background="{ThemeResource AppSettingsBg}" BorderBrush="{ThemeResource AppSettingsBorder}" BorderThickness="1" Foreground="{ThemeResource AppTextPrimary}"
                            CornerRadius="16" Padding="12,6" ToolTipService.ToolTip="Visualizador y editor de metadatos"
                            Click="OpenMetadata_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8EC;" FontSize="13" Foreground="#BB86FC"/>
                            <TextBlock Text="Metadatos" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Botón Ajustes (Abre la nueva Ventana de Ajustes) -->
                    <Button Background="{ThemeResource AppSettingsBg}" BorderBrush="{ThemeResource AppSettingsBorder}" BorderThickness="1" Foreground="{ThemeResource AppTextPrimary}"
                            CornerRadius="16" Padding="12,6" ToolTipService.ToolTip="Ajustes de la aplicación"
                            Click="OpenSettings_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE713;" FontSize="13" Foreground="#BB86FC"/>
                            <TextBlock Text="Ajustes" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. MAIN WORKSPACE: FLOATING COLLAPSIBLE SIDEBAR + DYNAMIC VIEW -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Floating Sidebar Capsule + Toggle -->
                <ColumnDefinition Width="*"/>    <!-- Main View Content -->
            </Grid.ColumnDefinitions>

            <!-- Floating Sidebar Area (Mockup Pill Design) -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Vertical Rounded Pill Capsule -->
                <Border x:Name="SidebarContainer"
                        Visibility="{x:Bind ViewModel.SidebarVisibility, Mode=OneWay}"
                        Background="{ThemeResource AppSidebarBg}"
                        BorderBrush="{ThemeResource AppAccent}"
                        BorderThickness="1"
                        CornerRadius="26"
                        Width="175"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center">
                    <StackPanel Spacing="6" Padding="10,16">
                        <!-- Inicio -->
                        <Button Command="{x:Bind ViewModel.NavigateHomeCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="{x:Bind ViewModel.NavHomeBg, Mode=OneWay}"
                                BorderThickness="0" CornerRadius="16" Padding="12,10">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE80F;" FontSize="16" Foreground="{x:Bind ViewModel.NavHomeFg, Mode=OneWay}"/>
                                <TextBlock Text="Inicio" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{x:Bind ViewModel.NavHomeFg, Mode=OneWay}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Canciones -->
                        <Button Command="{x:Bind ViewModel.NavigateSongsCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="{x:Bind ViewModel.NavSongsBg, Mode=OneWay}"
                                BorderThickness="0" CornerRadius="16" Padding="12,10">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xEC4F;" FontSize="16" Foreground="{x:Bind ViewModel.NavSongsFg, Mode=OneWay}"/>
                                <TextBlock Text="Canciones" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{x:Bind ViewModel.NavSongsFg, Mode=OneWay}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Álbumes -->
                        <Button Command="{x:Bind ViewModel.NavigateAlbumsCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="{x:Bind ViewModel.NavAlbumsBg, Mode=OneWay}"
                                BorderThickness="0" CornerRadius="16" Padding="12,10">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE93C;" FontSize="16" Foreground="{x:Bind ViewModel.NavAlbumsFg, Mode=OneWay}"/>
                                <TextBlock Text="Álbumes" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{x:Bind ViewModel.NavAlbumsFg, Mode=OneWay}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Artistas -->
                        <Button Command="{x:Bind ViewModel.NavigateArtistsCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="{x:Bind ViewModel.NavArtistsBg, Mode=OneWay}"
                                BorderThickness="0" CornerRadius="16" Padding="12,10">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE77B;" FontSize="16" Foreground="{x:Bind ViewModel.NavArtistsFg, Mode=OneWay}"/>
                                <TextBlock Text="Artistas" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{x:Bind ViewModel.NavArtistsFg, Mode=OneWay}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Playlists -->
                        <Button Command="{x:Bind ViewModel.NavigatePlaylistsCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="{x:Bind ViewModel.NavPlaylistsBg, Mode=OneWay}"
                                BorderThickness="0" CornerRadius="16" Padding="12,10">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE8F1;" FontSize="16" Foreground="{x:Bind ViewModel.NavPlaylistsFg, Mode=OneWay}"/>
                                <TextBlock Text="Playlists" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{x:Bind ViewModel.NavPlaylistsFg, Mode=OneWay}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Ecualizador -->
                        <Button Command="{x:Bind ViewModel.NavigateEqualizerCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="{x:Bind ViewModel.NavEqBg, Mode=OneWay}"
                                BorderThickness="0" CornerRadius="16" Padding="12,10">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE9E9;" FontSize="16" Foreground="{x:Bind ViewModel.NavEqFg, Mode=OneWay}"/>
                                <TextBlock Text="Ecualizador" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{x:Bind ViewModel.NavEqFg, Mode=OneWay}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Sidebar Toggle Pill Button (< / >) -->
                <Button Command="{x:Bind ViewModel.ToggleSidebarCommand}"
                        Width="22" Height="38" CornerRadius="11" Padding="0"
                        Background="{ThemeResource AppSidebarToggleBg}" BorderBrush="{ThemeResource AppAccent}" BorderThickness="1"
                        Margin="6,0,10,0" VerticalAlignment="Center"
                        ToolTipService.ToolTip="{x:Bind ViewModel.SidebarToggleTooltip, Mode=OneWay}">
                    <FontIcon Glyph="{x:Bind ViewModel.SidebarToggleIconGlyph, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource AppAccent}"/>
                </Button>
            </StackPanel>

            <!-- Dynamic Main View Content with Entrance Transitions -->
            <ContentControl Grid.Column="1"
                            x:Name="MainViewPresenter"
                            Content="{x:Bind ViewModel.CurrentView, Mode=OneWay}"
                            ContentTemplateSelector="{StaticResource MainViewSelector}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <ContentControl.ContentTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="24" IsStaggeringEnabled="False"/>
                    </TransitionCollection>
                </ContentControl.ContentTransitions>
            </ContentControl>
        </Grid>

        <!-- 2. FLOATING BOTTOM PLAYER BAR (Mockup Capsule Design) -->
        <Border Grid.Row="2"
                Margin="32,0,32,16"
                Height="86"
                CornerRadius="24"
                Background="{ThemeResource AppPlayerBg}"
                BorderBrush="{ThemeResource AppAccent}"
                BorderThickness="1"
                Visibility="{x:Bind ViewModel.BottomPlayerBarVisibility, Mode=OneWay}">
            <Grid Padding="20,4,20,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Track Info (Clickable to open Now Playing Overlay) -->
                <Button Grid.Column="0" Command="{x:Bind ViewModel.OpenNowPlayingCommand}"
                        Background="Transparent" BorderThickness="0" Padding="2" CornerRadius="10"
                        HorizontalAlignment="Left" HorizontalContentAlignment="Left">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Album Cover Thumbnail -->
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="9" Background="{ThemeResource AppCoverPlaceholderBg}">
                            <Grid>
                                <FontIcon Glyph="&#xEC4F;" FontSize="20" Foreground="{ThemeResource AppCoverPlaceholderFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{x:Bind ViewModel.CurrentTrack.CoverImagePath, Mode=OneWay}" Stretch="UniformToFill"/>
                            </Grid>
                        </Border>

                        <!-- Title and Artist -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{x:Bind ViewModel.CurrentTrack.Title, Mode=OneWay, FallbackValue='Sin música seleccionada'}"
                                       FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource AppTextPrimary}"
                                       TextTrimming="CharacterEllipsis" MaxLines="1"/>
                            <TextBlock Text="{x:Bind ViewModel.CurrentTrack.Artist, Mode=OneWay, FallbackValue='Elige una canción para reproducir'}"
                                       FontSize="11" Foreground="{ThemeResource AppTextMuted}"
                                       TextTrimming="CharacterEllipsis" MaxLines="1"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Center: Playback Controls & Progress Bar -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
                    <!-- Buttons row -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14" VerticalAlignment="Center">
                        <!-- Shuffle -->
                        <Button Command="{x:Bind ViewModel.ToggleShuffleCommand}"
                                Background="Transparent" BorderThickness="0" Padding="0" Width="28" Height="28" CornerRadius="14"
                                Foreground="{x:Bind ViewModel.ShuffleBrush, Mode=OneWay}" ToolTipService.ToolTip="Aleatorio">
                            <FontIcon Glyph="&#xE8B1;" FontSize="13"/>
                        </Button>

                        <!-- Previous -->
                        <Button Command="{x:Bind ViewModel.PreviousCommand}"
                                Background="Transparent" BorderThickness="0" Padding="0" Width="32" Height="32" CornerRadius="16"
                                Foreground="{ThemeResource AppTextPrimary}" ToolTipService.ToolTip="Anterior">
                            <FontIcon Glyph="&#xE892;" FontSize="15"/>
                        </Button>

                        <!-- FAB PLAY/PAUSE (Material 3 Compact Action Button) -->
                        <Button Command="{x:Bind ViewModel.PlayPauseCommand}"
                                Background="#BB86FC" Foreground="#121212"
                                Width="42" Height="42" CornerRadius="21" Padding="0"
                                ToolTipService.ToolTip="{x:Bind ViewModel.PlayPauseTooltip, Mode=OneWay}">
                            <FontIcon Glyph="{x:Bind ViewModel.PlayPauseIconGlyph, Mode=OneWay}" FontSize="17"/>
                        </Button>

                        <!-- Next -->
                        <Button Command="{x:Bind ViewModel.NextCommand}"
                                Background="Transparent" BorderThickness="0" Padding="0" Width="32" Height="32" CornerRadius="16"
                                Foreground="{ThemeResource AppTextPrimary}" ToolTipService.ToolTip="Siguiente">
                            <FontIcon Glyph="&#xE893;" FontSize="15"/>
                        </Button>

                        <!-- Repeat -->
                        <Button Command="{x:Bind ViewModel.ToggleRepeatCommand}"
                                Background="Transparent" BorderThickness="0" Padding="0" Width="28" Height="28" CornerRadius="14"
                                Foreground="{x:Bind ViewModel.RepeatBrush, Mode=OneWay}" ToolTipService.ToolTip="Repetir">
                            <FontIcon Glyph="&#xE8EE;" FontSize="13"/>
                        </Button>
                    </StackPanel>

                    <!-- Seek Bar row -->
                    <Grid Width="450" ColumnSpacing="10" Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.CurrentPositionFormatted, Mode=OneWay, FallbackValue='00:00'}"
                                   FontSize="11" Foreground="{ThemeResource AppTextSubtle}" VerticalAlignment="Center"/>

                        <Slider Grid.Column="1"
                                Maximum="{x:Bind ViewModel.TotalDurationSeconds, Mode=OneWay, FallbackValue=100}"
                                Value="{x:Bind ViewModel.CurrentPositionSeconds, Mode=OneWay}"
                                ValueChanged="SeekSlider_ValueChanged"
                                VerticalAlignment="Center" Margin="0" MinHeight="0" Height="30"/>

                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.TotalDurationFormatted, Mode=OneWay, FallbackValue='00:00'}"
                                   FontSize="11" Foreground="{ThemeResource AppTextSubtle}" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <!-- Right: Extra Controls (Heart Like, Playlist, EQ Shortcut, Volume) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                    <!-- Like (Heart) Button -->
                    <Button Command="{x:Bind ViewModel.LikeTrackCommand}"
                            Background="Transparent" BorderThickness="0" Padding="0" Width="34" Height="34" CornerRadius="17"
                            ToolTipService.ToolTip="{x:Bind ViewModel.LikeTooltipText, Mode=OneWay}">
                        <FontIcon Glyph="{x:Bind ViewModel.LikeGlyph, Mode=OneWay}" FontSize="16"
                                  Foreground="{x:Bind ViewModel.LikeBrush, Mode=OneWay}"/>
                    </Button>

                    <!-- Add to Playlist Button -->
                    <Button x:Name="PlayerAddToPlaylistBtn"
                            Click="PlayerAddToPlaylist_Click"
                            Background="Transparent" BorderThickness="0" Padding="0" Width="34" Height="34" CornerRadius="17"
                            Foreground="#B0B0B0" ToolTipService.ToolTip="Añadir canción actual a una playlist">
                        <FontIcon Glyph="&#xE8F1;" FontSize="15"/>
                    </Button>

                    <!-- EQ Shortcut -->
                    <Button Command="{x:Bind ViewModel.NavigateEqualizerCommand}"
                            Background="Transparent" BorderThickness="0" Padding="0" Width="34" Height="34" CornerRadius="17"
                            Foreground="#B0B0B0" ToolTipService.ToolTip="Abrir Ecualizador">
                        <FontIcon Glyph="&#xE9E9;" FontSize="15"/>
                    </Button>

                    <!-- Volume icon -->
                    <FontIcon Glyph="{x:Bind ViewModel.VolumeIconGlyph, Mode=OneWay}" FontSize="14" Foreground="#888888" VerticalAlignment="Center"/>

                    <!-- Volume slider -->
                    <Slider Width="75" Minimum="0" Maximum="100"
                            Value="{x:Bind ViewModel.Volume, Mode=TwoWay}"
                            VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. NOW PLAYING FULL SCREEN OVERLAY (2.2v Redesign based on Mockup) -->
        <Grid Grid.RowSpan="3" x:Name="NowPlayingOverlay"
              Background="#0D0C12"
              Visibility="{x:Bind ViewModel.NowPlayingExpandedVisibility, Mode=OneWay}"
              Canvas.ZIndex="100">
            <Grid.Transitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="60" IsStaggeringEnabled="False"/>
                </TransitionCollection>
            </Grid.Transitions>

            <!-- Immersive Heavily Blurred Cover Art Background (~80% blur) -->
            <Image Source="{x:Bind ViewModel.CurrentBlurredCover, Mode=OneWay}"
                   Stretch="UniformToFill"
                   Opacity="0.80"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
            <!-- Subtle dark vignette tint (not too dark to let vibrant colors shine through) -->
            <Border Background="#260C0C14"/>

            <!-- Main Layout Grid: Top Bar, Center Content, Bottom Playback -->
            <Grid Padding="36,20,36,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Top Bar -->
                    <RowDefinition Height="*"/>    <!-- Center Stage (Cover/Pill or Lyrics, plus Queue Drawer) -->
                    <RowDefinition Height="Auto"/> <!-- Bottom Playback (Seek Bar + Controls) -->
                </Grid.RowDefinitions>

                <!-- TOP BAR: Back pill ("REPRODUCIENDO AHORA") and "Cola de Reproducción" toggle button -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Top Left: Back Pill ("REPRODUCIENDO AHORA") - 100% Solid Opacity -->
                    <Button Grid.Column="0" Command="{x:Bind ViewModel.CloseNowPlayingCommand}"
                            Background="#1C1C24" BorderBrush="#26FFFFFF" BorderThickness="1"
                            CornerRadius="16" Padding="14,8"
                            ToolTipService.ToolTip="Volver">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE70D;" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="REPRODUCIENDO AHORA" FontSize="12" FontWeight="Bold" Foreground="White"
                                       CharacterSpacing="60" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Top Right: "Cola de Reproducción" Toggle Button - 100% Solid Opacity -->
                    <Button Grid.Column="2" Command="{x:Bind ViewModel.ToggleNowPlayingQueueCommand}"
                            Background="{x:Bind ViewModel.QueueToggleBrush, Mode=OneWay}"
                            BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="16" Padding="16,8"
                            ToolTipService.ToolTip="Mostrar u ocultar la cola de reproducción">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8D6;" FontSize="14" Foreground="{x:Bind ViewModel.QueueToggleForegroundBrush, Mode=OneWay}" VerticalAlignment="Center"/>
                            <TextBlock Text="Cola de Reproducción" FontSize="13" FontWeight="SemiBold" Foreground="{x:Bind ViewModel.QueueToggleForegroundBrush, Mode=OneWay}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- CENTER STAGE: Content Area (Art + Tag or Lyrics) + Right Queue Drawer -->
                <Grid Grid.Row="1" Margin="0,8,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT / CENTER AREA: Standard Cover & Tag Pill OR Synchronized Lyrics View -->
                    <Grid Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                        <!-- View Mode 1: Standard Cover Art & Song Tag Pill (Mockup Layout in Bottom-Left) -->
                        <Grid HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="32,0,0,16"
                              Visibility="{x:Bind ViewModel.AlbumCoverVisibility, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Big Album Art with Rounded Corners -->
                            <Border Grid.Column="0" Width="380" Height="380" CornerRadius="28" Background="#1E1E24"
                                    BorderBrush="#20FFFFFF" BorderThickness="1">
                                <Grid>
                                    <FontIcon Glyph="&#xEC4F;" FontSize="96" Foreground="#444450" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image Source="{x:Bind ViewModel.CurrentTrack.CoverImagePath, Mode=OneWay}" Stretch="UniformToFill"/>
                                </Grid>
                            </Border>

                            <!-- Dark Tag Box Pill (100% Solid Opacity) -->
                            <Border Grid.Column="1" VerticalAlignment="Bottom" Margin="-30,0,0,28"
                                    Background="#16161C" BorderBrush="#26FFFFFF" BorderThickness="1"
                                    CornerRadius="18" Padding="24,18" MaxWidth="380">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{x:Bind ViewModel.CurrentTrack.Title, Mode=OneWay, FallbackValue='Sin Canción'}"
                                               FontSize="32" FontWeight="Bold" Foreground="White"
                                               TextTrimming="CharacterEllipsis" MaxLines="2"/>
                                    <TextBlock Text="{x:Bind ViewModel.CurrentTrack.Artist, Mode=OneWay, FallbackValue='Desconocido'}"
                                               FontSize="18" Foreground="#CCCCCC" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                    <TextBlock Text="{x:Bind ViewModel.CurrentTrack.Album, Mode=OneWay, FallbackValue=''}"
                                               FontSize="14" Foreground="#888888" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- View Mode 2: Synchronized LRC Lyrics View -->
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="20,0,20,0"
                              Visibility="{x:Bind ViewModel.LyricsVisibility, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Medium Album Art + Track Info -->
                            <StackPanel Grid.Column="0" Spacing="16" VerticalAlignment="Bottom" Margin="16,0,36,24" MaxWidth="280">
                                <Border Width="260" Height="260" CornerRadius="22" Background="#1E1E24" BorderBrush="#20FFFFFF" BorderThickness="1">
                                    <Grid>
                                        <FontIcon Glyph="&#xEC4F;" FontSize="64" Foreground="#444450" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{x:Bind ViewModel.CurrentTrack.CoverImagePath, Mode=OneWay}" Stretch="UniformToFill"/>
                                    </Grid>
                                </Border>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind ViewModel.CurrentTrack.Title, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind ViewModel.CurrentTrack.Artist, Mode=OneWay}" FontSize="15" Foreground="#CCCCCC" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Lyrics List and No Lyrics Fallback -->
                            <Grid Grid.Column="1" VerticalAlignment="Stretch" Margin="10,10,10,10">
                                <ListView x:Name="LyricsListView"
                                          ItemsSource="{x:Bind ViewModel.CurrentLyricsLines, Mode=OneWay}"
                                          SelectionMode="None"
                                          IsItemClickEnabled="True"
                                          ItemClick="LyricLine_ItemClick"
                                          Visibility="{x:Bind ViewModel.HasLyricsVisibility, Mode=OneWay}"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          Padding="10,40,10,40">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:LrcLine">
                                            <Grid Padding="8,8" Margin="0,4" HorizontalAlignment="Stretch">
                                                <TextBlock Text="{x:Bind Text}"
                                                           FontSize="{x:Bind FontSizeFormatted, Mode=OneWay}"
                                                           FontWeight="{x:Bind FontWeightFormatted, Mode=OneWay}"
                                                           Opacity="{x:Bind OpacityFormatted, Mode=OneWay}"
                                                           Foreground="White"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Left"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <StackPanel Visibility="{x:Bind ViewModel.NoLyricsVisibility, Mode=OneWay}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                    <FontIcon Glyph="&#xEC4F;" FontSize="48" Foreground="#555566"/>
                                    <TextBlock Text="No hay letra sincronizada (.lrc) para esta canción"
                                               FontSize="16" FontWeight="SemiBold" Foreground="#B0B0B0" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Puedes crear marcas de tiempo fácilmente usando el generador de LRC en el editor de metadatos."
                                               FontSize="12" Foreground="#777788" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center"/>
                                    <Button Click="OpenLyricsMetadata_Click"
                                            Background="#2A2438" BorderBrush="#BB86FC" BorderThickness="1" CornerRadius="14" Padding="16,8"
                                            HorizontalAlignment="Center" Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE70F;" FontSize="13" Foreground="#BB86FC"/>
                                            <TextBlock Text="Crear letra sincronizada" FontSize="13" Foreground="#BB86FC" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- RIGHT COLUMN: Cola de Reproducción (Queue Drawer, 100% Solid Opacity) -->
                    <Border Grid.Column="1" Width="360"
                            Background="#141419" BorderBrush="#26FFFFFF" BorderThickness="1"
                            CornerRadius="20" Padding="16,14"
                            Visibility="{x:Bind ViewModel.NowPlayingQueueVisibility, Mode=OneWay}"
                            Margin="24,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Queue Header with Count, Save as Playlist, and Clear -->
                            <Grid Grid.Row="0" Margin="4,0,4,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Queue Title with Icon -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8D6;" FontSize="14" Foreground="#BB86FC"/>
                                    <TextBlock Text="{x:Bind ViewModel.QueueCountText, Mode=OneWay}"
                                               FontWeight="Bold" FontSize="13" Foreground="#BB86FC" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Header Action Buttons -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <!-- Guardar como Playlist Button -->
                                    <Button Click="SaveQueueAsPlaylist_Click"
                                            Background="#22BB86FC" BorderThickness="0" Padding="8,4" CornerRadius="10"
                                            ToolTipService.ToolTip="Guardar la cola de reproducción como una nueva Playlist">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE8F8;" FontSize="11" Foreground="#D0BCFF"/>
                                            <TextBlock Text="Guardar Playlist" FontSize="11" FontWeight="SemiBold" Foreground="#D0BCFF"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Limpiar Button -->
                                    <Button Click="ClearQueue_Click"
                                            Background="Transparent" BorderThickness="0" Padding="6,4" CornerRadius="10"
                                            ToolTipService.ToolTip="Vaciar cola de reproducción">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="#888888"/>
                                            <TextBlock Text="Limpiar" FontSize="11" Foreground="#888888"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Reorderable Queue ListView -->
                            <ListView Grid.Row="1" x:Name="QueueListView"
                                      ItemsSource="{x:Bind ViewModel.CurrentQueue, Mode=OneWay}"
                                      SelectedIndex="{x:Bind ViewModel.CurrentQueueIndex, Mode=TwoWay}"
                                      CanReorderItems="True"
                                      AllowDrop="True"
                                      CanDragItems="True"
                                      DragItemsCompleted="Queue_DragItemsCompleted"
                                      SelectionMode="Single"
                                      IsItemClickEnabled="True"
                                      ItemClick="QueueItem_Click">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Track">
                                        <Grid Padding="4,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="28"/>
                                            </Grid.ColumnDefinitions>

                                            <FontIcon Grid.Column="0" Glyph="&#xE76F;" FontSize="11" Foreground="#666677"
                                                      VerticalAlignment="Center" HorizontalAlignment="Left"/>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,8,0">
                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{x:Bind Artist}" FontSize="11" Foreground="#9999AA" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{x:Bind DurationFormatted}" FontSize="11" Foreground="#777788"
                                                       VerticalAlignment="Center" Margin="4,0,4,0"/>

                                            <Button Grid.Column="3" Click="RemoveQueueTrack_Click" Tag="{x:Bind}"
                                                    Background="Transparent" BorderThickness="0" Padding="0" Width="24" Height="24" CornerRadius="12"
                                                    HorizontalAlignment="Right" ToolTipService.ToolTip="Quitar de la cola">
                                                <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="#888899"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>

                <!-- BOTTOM PLAYBACK BAR: Full-Width Seek Bar Flanked by Timestamps + Controls Row -->
                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Full-width seek bar with timestamps -->
                        <RowDefinition Height="Auto"/> <!-- Controls row -->
                    </Grid.RowDefinitions>

                    <!-- Full-width seek bar flanked by timestamps (Solid badge containers for 100% visibility) -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Current Position Timestamp Badge -->
                        <Border Grid.Column="0" Background="#1C1C24" BorderBrush="#26FFFFFF" BorderThickness="1"
                                CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.CurrentPositionFormatted, Mode=OneWay, FallbackValue='00:00'}"
                                       FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </Border>

                        <Slider Grid.Column="1"
                                Maximum="{x:Bind ViewModel.TotalDurationSeconds, Mode=OneWay, FallbackValue=100}"
                                Value="{x:Bind ViewModel.CurrentPositionSeconds, Mode=OneWay}"
                                ValueChanged="SeekSlider_ValueChanged"
                                VerticalAlignment="Center" Margin="14,0" MinHeight="0" Height="26"/>

                        <!-- Total Duration Timestamp Badge -->
                        <Border Grid.Column="2" Background="#1C1C24" BorderBrush="#26FFFFFF" BorderThickness="1"
                                CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.TotalDurationFormatted, Mode=OneWay, FallbackValue='00:00'}"
                                       FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- Controls Row: Playback Controls Capsule + Pill with Like, Lyrics, EQ, Fullscreen, Volume -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Solid pill capsule for Playback Controls (Shuffle, Prev, Play/Pause, Next, Repeat) -->
                        <Border Grid.Column="0" HorizontalAlignment="Left" Background="#1C1C24" BorderBrush="#26FFFFFF" BorderThickness="1"
                                CornerRadius="28" Padding="14,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                <!-- Shuffle -->
                                <Button Command="{x:Bind ViewModel.ToggleShuffleCommand}"
                                        Background="Transparent" BorderThickness="0" Width="38" Height="38" CornerRadius="19"
                                        Foreground="{x:Bind ViewModel.ShuffleBrush, Mode=OneWay}" ToolTipService.ToolTip="Aleatorio">
                                    <FontIcon Glyph="&#xE8B1;" FontSize="16"/>
                                </Button>

                                <!-- Previous -->
                                <Button Command="{x:Bind ViewModel.PreviousCommand}"
                                        Background="Transparent" BorderThickness="0" Width="40" Height="40" CornerRadius="20"
                                        Foreground="White" ToolTipService.ToolTip="Anterior">
                                    <FontIcon Glyph="&#xE892;" FontSize="18"/>
                                </Button>

                                <!-- Play / Pause FAB -->
                                <Button Command="{x:Bind ViewModel.PlayPauseCommand}"
                                        Background="#BB86FC" Foreground="#121212"
                                        Width="50" Height="50" CornerRadius="25" Padding="0"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.PlayPauseTooltip, Mode=OneWay}">
                                    <FontIcon Glyph="{x:Bind ViewModel.PlayPauseIconGlyph, Mode=OneWay}" FontSize="20"/>
                                </Button>

                                <!-- Next -->
                                <Button Command="{x:Bind ViewModel.NextCommand}"
                                        Background="Transparent" BorderThickness="0" Width="40" Height="40" CornerRadius="20"
                                        Foreground="White" ToolTipService.ToolTip="Siguiente">
                                    <FontIcon Glyph="&#xE893;" FontSize="18"/>
                                </Button>

                                <!-- Repeat -->
                                <Button Command="{x:Bind ViewModel.ToggleRepeatCommand}"
                                        Background="Transparent" BorderThickness="0" Width="38" Height="38" CornerRadius="19"
                                        Foreground="{x:Bind ViewModel.RepeatBrush, Mode=OneWay}" ToolTipService.ToolTip="Repetir">
                                    <FontIcon Glyph="&#xE8EE;" FontSize="16"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Right: Capsule pill (100% Solid Opacity) with Like, Lyrics, EQ, Fullscreen, Volume -->
                        <Border Grid.Column="1" Background="#1C1C24" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="28" Padding="14,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                <!-- Like (Heart) Button -->
                                <Button Command="{x:Bind ViewModel.LikeTrackCommand}"
                                        Background="Transparent" BorderThickness="0" Padding="0" Width="36" Height="36" CornerRadius="18"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.LikeTooltipText, Mode=OneWay}">
                                    <FontIcon Glyph="{x:Bind ViewModel.LikeGlyph, Mode=OneWay}" FontSize="16"
                                              Foreground="{x:Bind ViewModel.LikeBrush, Mode=OneWay}"/>
                                </Button>

                                <!-- Lyrics Toggle Button ("Mostrar letra") -->
                                <Button Command="{x:Bind ViewModel.ToggleLyricsCommand}"
                                        Background="Transparent" BorderThickness="0" Padding="0" Width="36" Height="36" CornerRadius="18"
                                        ToolTipService.ToolTip="Mostrar/Ocultar letra sincronizada (LRC)">
                                    <FontIcon Glyph="&#xEC4F;" FontSize="16" Foreground="{x:Bind ViewModel.LyricsBrush, Mode=OneWay}"/>
                                </Button>

                                <!-- EQ Shortcut Button -->
                                <Button Command="{x:Bind ViewModel.NavigateEqualizerCommand}"
                                        Background="Transparent" BorderThickness="0" Padding="0" Width="36" Height="36" CornerRadius="18"
                                        Foreground="#D0D0DC" ToolTipService.ToolTip="Abrir Ecualizador">
                                    <FontIcon Glyph="&#xE9E9;" FontSize="16"/>
                                </Button>

                                <!-- FullScreen Toggle Button -->
                                <Button Click="ToggleFullScreen_Click"
                                        Background="Transparent" BorderThickness="0" Padding="0" Width="36" Height="36" CornerRadius="18"
                                        Foreground="#D0D0DC" ToolTipService.ToolTip="{x:Bind ViewModel.FullScreenTooltip, Mode=OneWay}">
                                    <FontIcon Glyph="{x:Bind ViewModel.FullScreenGlyph, Mode=OneWay}" FontSize="16"/>
                                </Button>

                                <!-- Volume Icon -->
                                <FontIcon Glyph="{x:Bind ViewModel.VolumeIconGlyph, Mode=OneWay}" FontSize="15" Foreground="#AFAFB9" VerticalAlignment="Center" Margin="4,0,2,0"/>

                                <!-- Volume Slider -->
                                <Slider Width="85" Minimum="0" Maximum="100"
                                        Value="{x:Bind ViewModel.Volume, Mode=TwoWay}"
                                        VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>

